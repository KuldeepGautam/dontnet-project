@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVIDViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix VI-D : Available Internal Resources with Grantee Bodies/Autonomous Institutions";
    // Client review 2026-08-05 ("show year wherever missing"): the "as on"/"expected" columns were
    // hardcoded to literal dates - computed off FinancialYear instead.
    var y = Model.FinancialYear;
    var march31Year = Model.YearOffset(-2).Split('-')[1];
    var sept30Year = Model.PriorFinancialYear.Split('-')[0];
    var expectedMarch31Year = y.Split('-')[0];
    var locked = Model.IsEntryLocked;

    // "Approved design for all appendixes" (2026-09-08, UBIS-Pre-budget-html/Appendix6d.html) -
    // same drawer/grid theme already shipped for Appendix VI-A/VI-B/VI-C. Field set unchanged from
    // the prior inline-table layout - Name of Institute is an AutonomousBodyId FK dropdown, not
    // free text (client testing feedback 2026-08-24 reverted an earlier free-text attempt), so the
    // design mockup's separate "Name of the Grantee Body" text field (a leftover from before that
    // reversion, never updated in the static mockup) is not reproduced here.
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="file-spreadsheet" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix VI-D</h2>
                        <span id="vidRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span>
                    @if (Model.IsAppendixFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else if (Model.IsNilSubmitted)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>NIL
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Available internal resources with Grantee Bodies/Autonomous Institutions</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @* Freeze/Nil moved out of the drawer to sit next to Add, per designer markup
                   (2026-09-08) - see AppendixVIA.cshtml's matching comment. *@
                @if (Model.Records.Count == 0 && !locked)
                {
                    <button type="submit" form="appendixVIDForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (Model.Records.Count > 0 && !locked)
                {
                    <button type="submit" form="appendixVIDForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!locked)
                {
                    <button type="button" data-action="open-appendix-vid-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
        <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="vidSearchInput" type="search" placeholder="Search institution..." class="search-control" /></div>
            <div class="flex items-center gap-2">
               
                <div class="relative">
                    <button id="vidColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vidColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="vidColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="institution" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Name Of Institution</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="asonmarch31" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">As on 31 March</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="asonsept30" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">As on 30 September</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="expmarch31" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Expected upto 31 March</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="expfy" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Expected (FY)</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="remarks" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Remarks</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-vid-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <button id="vidExportButton" type="button" data-action="toggle-appendix-vid-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vidExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="vidExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-vid" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-vid" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-vid" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="vidGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="chargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th class="w-[4%] px-2 py-3 text-center">S.No.</th>
                        <th data-column="institution" class="w-[24%] px-2 py-3">
                            <button type="button" data-sort-key="institution" class="flex items-center gap-1.5">Name Of Institution</button>
                        </th>
                        <th data-column="asonmarch31" class="w-[13%] px-2 py-3 text-right"><button type="button" data-sort-key="asonmarch31" class="ml-auto flex items-center gap-1">As on<br>31 Mar @march31Year</button></th>
                        <th data-column="asonsept30" class="w-[13%] px-2 py-3 text-right"><button type="button" data-sort-key="asonsept30" class="ml-auto flex items-center gap-1">As on<br>30 Sep @sept30Year</button></th>
                        <th data-column="expmarch31" class="w-[14%] px-2 py-3 text-right"><button type="button" data-sort-key="expmarch31" class="ml-auto flex items-center gap-1">Expected upto<br>31 Mar @expectedMarch31Year</button></th>
                        <th data-column="expfy" class="w-[12%] px-2 py-3 text-right"><button type="button" data-sort-key="expfy" class="ml-auto flex items-center gap-1">Expected<br>@y</button></th>
                        <th data-column="remarks" class="w-[7%] px-2 py-3">Remarks</th>
                        @if (!locked)
                        {
                            <th class="w-[5%] px-2 py-3 text-center">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="gridBody" class="divide-y divide-slate-100">
                    @for (var i = 0; i < Model.Records.Count; i++)
                    {
                        var r = Model.Records[i];
                        var status = r.IsFrozen ? "Frozen" : "Active";
                        var searchHaystack = string.Join(" ", new[] { r.Id.ToString(), r.AutonomousBodyName, status });
                        <tr data-row data-status="@status" data-search="@searchHaystack" data-sort-institution="@r.AutonomousBodyName"
                            data-sort-asonmarch31="@r.AsOnMarch31" data-sort-asonsept30="@r.AsOnJune30" data-sort-expmarch31="@r.ExpectedNextMarch31" data-sort-expfy="@r.ExpectedNextFY"
                            class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                            <td class="relative px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>
                                @if (r.IsFrozen)
                                {
                                    <span class="absolute left-0 top-0 bottom-0 w-1 bg-slate-700" title="Frozen record"></span>
                                }
                                @(i + 1)
                            </td>
                            <td data-column="institution" class="break-words px-2 py-3 text-xs font-bold leading-5 text-slate-800">@(r.AutonomousBodyName ?? "-")</td>
                            <td data-column="asonmarch31" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.AsOnMarch31?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="asonsept30" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.AsOnJune30?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="expmarch31" class="tabular px-2 py-3 text-right text-xs font-bold text-indigo-800">@(r.ExpectedNextMarch31?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="expfy" class="tabular px-2 py-3 text-right text-xs font-bold text-indigo-800">@(r.ExpectedNextFY?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="remarks" class="break-words px-2 py-3 text-xs text-slate-500">
                                @if (string.IsNullOrEmpty(r.Remarks))
                                {
                                    @:—
                                }
                                else
                                {
                                    <span class="via-remarks-clamp" title="@r.Remarks">@r.Remarks</span>
                                }
                            </td>
                            @if (!locked)
                            {
                                <td class="grid-action-cell px-2 py-3 text-center">
                                    @if (!r.IsFrozen)
                                    {
                                        <div class="relative inline-block">
                                            <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                    data-action-id="@r.Id" aria-label="Actions for @r.AutonomousBodyName" aria-haspopup="true">
                                                <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                            </button>
                                            <div id="vid-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                        data-action="edit-appendix-vid-record"
                                                        data-id="@r.Id"
                                                        data-autonomous-body-id="@r.AutonomousBodyId"
                                                        data-as-on-march31="@r.AsOnMarch31"
                                                        data-as-on-june30="@r.AsOnJune30"
                                                        data-expected-next-march31="@r.ExpectedNextMarch31"
                                                        data-expected-next-fy="@r.ExpectedNextFY"
                                                        data-remarks="@r.Remarks">
                                                    <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                </button>
                                                <button type="button" data-action="delete-appendix-vid-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                </button>
                                                <form method="post" asp-action="DeleteAppendixVID" class="hidden">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="vidEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-vid-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="vidRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="vidTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="vidPageSize" data-action="change-appendix-vid-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="vidPrevBtn" type="button" data-action="appendix-vid-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="vidPageNumbers" class="flex items-center gap-1"></div>
                <button id="vidNextBtn" type="button" data-action="appendix-vid-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-vid-drawer" here, same fix already
         proven for VI-A. Only the header's X button and the footer's Cancel button close it. -->
    <div id="vidDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action as before) -->
    <aside id="vidDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Internal resources form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="vidDrawerTitle" class="text-base font-bold text-ubis-navy">Add Internal Resources</h2>
                    @* <p id="vidDrawerSubtitle" class="text-[11px] text-slate-500">Create a new internal-resources record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixVID" id="appendixVIDForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixVID-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="VI-D" />
            <input type="hidden" name="appendixId" value="@Model.AppendixId" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                @if (Model.IsNilSubmitted)
                {
                    <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                }
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid gap-4 p-4">
                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Name of GranteeBody/Autonomous Institution <span class="text-red-500">*</span></label>
                            <select asp-for="NewRecord.AutonomousBodyId" required
                                    class="form-field h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50">
                                <option value="">Select</option>
                                @foreach (var ab in Model.AutonomousBodies)
                                {
                                    <option value="@ab.AutonomousBodyId">@ab.Name</option>
                                }
                            </select>
                            <p class="mt-1.5 text-[10px] text-red-600">To populate Autonomous in this list you need to add Autonomous to the master first. (RE Meeting → Autonomous Master for Appendix VI C and VI E)</p>
                        </div>
                    </div>

                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Internal Resources</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">As on 31st March @march31Year <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="revenue-input NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.AsOnMarch31" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">As on 30th September @sept30Year <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="revenue-input NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.AsOnJune30" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Expected upto 31st March @expectedMarch31Year <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="revenue-input NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.ExpectedNextMarch31" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Expected @y <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="revenue-input NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.ExpectedNextFY" />
                            </div>
                        </div>
                    </div>

                    <div class="p-4">
                        <label class="mb-1.5 block text-xs font-semibold text-slate-700">Remarks</label>
                        <textarea id="NewRecord_Remarks" name="NewRecord.Remarks" maxlength="1000" rows="4" placeholder="Enter remarks..." data-mask="no-special-chars"
                                  class="w-full resize-none rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:border-ubis-teal focus:ring-4 focus:ring-teal-50">@Model.NewRecord.Remarks</textarea>
                        <div class="mt-1.5 text-right text-[10px] text-slate-400"><span id="vidCharCount">@(Model.NewRecord.Remarks?.Length ?? 0)</span> / 1000</div>
                    </div>
                </section>
            </div>

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                    <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-vid-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                    <button type="button" class="hidden" data-action="cancel-edit"></button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="vidToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="vidToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="vidToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="vidToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="vidToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="vidDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="vidDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="vidDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                    <p id="vidDeleteRecordName" class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800"></p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="vidCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="vidConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
