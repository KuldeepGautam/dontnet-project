@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVIAViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix VI-A : List of User Charges levied by the Departments/Ministries";
    var y1 = Model.YearOffset(-4);
    var y2 = Model.YearOffset(-3);
    var y3 = Model.YearOffset(-2);
    var locked = Model.IsEntryLocked;
}

<section class="p-0 animate-fade-in">
    <div class="heading text-center heading-bg justify-between items-center border rounded px-4 py-3 text-white">
        Appendix VI A - List of User Charges levied by the Departments/Ministries
    </div>
    <div class="flex flex-col gap-3 border-b border-slate-200 p-5 md:flex-row md:items-center md:justify-between dark:border-slate-800">
        <span class="text-red-600 text-xs italic text-right ml-auto">Amount in Crores of Rupees</span>
    </div>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="px-5 pt-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <form method="post" autocomplete="off" asp-action="SaveAppendixVIA" id="appendixVIAForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixVIA-@Model.DemandId">
        @Html.AntiForgeryToken()
        <input type="hidden" name="demandId" value="@Model.DemandId" />
        <input type="hidden" name="code" value="VI-A" />
        <input type="hidden" asp-for="NewRecord.Id" />
        <fieldset disabled="@locked" style="border:none;margin:0;padding:0;">
        <div class="p-5">
            <table class="demo-table w-full text-sm">
                <tbody>
                    <tr>
                        <td class="font-semibold w-64">Title of the User Charge</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.TitleOfCharge" /></td>
                        <td class="font-semibold w-64">Services for which user charge is levied</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.Service" /></td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Organisation/Department which is collecting this User Charge</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.OrgDept" /></td>
                        <td class="font-semibold">Rate of User Charge and unit of collection</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.RateOfCharge" /></td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Date of fixation of the rate of the current User Charge</td>
                        <td><input class="input" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" title="Cannot be a future date" required asp-for="NewRecord.DateOfRateFixation" /></td>
                        <td class="font-semibold">Fixation Done under which statute/rule/Act/order/OM</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.FixationStatute" /></td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Total Revenue from User Charges in</td>
                        <td colspan="3">
                            <div class="grid grid-cols-3 gap-3">
                                <label class="table-toolbar-field-compact"><span>@y1</span><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.TotalRevenueY1" /></label>
                                <label class="table-toolbar-field-compact"><span>@y2</span><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.TotalRevenueY2" /></label>
                                <label class="table-toolbar-field-compact"><span>@y3</span><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.TotalRevenueY3" /></label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Competent Authority to refix the User Charge</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.CompetentAuthority" /></td>
                        <td class="font-semibold">Period of refixation of User Charge, if any specified in order, etc. given Col.6</td>
                        <td><input class="input" maxlength="250" required asp-for="NewRecord.PeriodOfFixation" /></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="font-bold text-center bg-slate-50 dark:bg-slate-800">Cost of delivering That Particular service (if available)</td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Salary and Emoluments of the staff involved in particular service</td>
                        <td><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.Salary" /></td>
                        <td class="font-semibold">Office Expenses (OE) of the relevant office for delivering particular service</td>
                        <td><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.OfficeExpenses" /></td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Other Expenses for delivering the particular service</td>
                        <td><input class="input NumericData" type="number" step="0.01" min="0" required asp-for="NewRecord.OtherExpenses" /></td>
                        <td class="font-semibold">Whether the cost of collection is higher than Revenue earned</td>
                        <td>
                            <label class="mr-4"><input type="radio" name="NewRecord.IsCollectionCostHigher" value="true" checked="@(Model.NewRecord.IsCollectionCostHigher ? "checked" : null)" /> Yes</label>
                            <label><input type="radio" name="NewRecord.IsCollectionCostHigher" value="false" checked="@(!Model.NewRecord.IsCollectionCostHigher ? "checked" : null)" /> No</label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-semibold">Whether the transaction cost for the user is higher than the rate of User Charge i.e., whether the rate of charge is less than the cost of DD/RTGS etc.</td>
                        <td>
                            <label class="mr-4"><input type="radio" name="NewRecord.IsTransCostHigher" value="true" checked="@(Model.NewRecord.IsTransCostHigher ? "checked" : null)" /> Yes</label>
                            <label><input type="radio" name="NewRecord.IsTransCostHigher" value="false" checked="@(!Model.NewRecord.IsTransCostHigher ? "checked" : null)" /> No</label>
                        </td>
                        <td class="font-semibold">Remarks</td>
                        <td><input class="input RemarksText" required asp-for="NewRecord.Remarks" /></td>
                    </tr>
                </tbody>
            </table>

        </div>
        </fieldset>
        <div class="mt-4 mb-5 flex flex-wrap justify-center gap-3">
            <fieldset disabled="@locked" style="display:contents;border:none;margin:0;padding:0;">
                <button type="submit" class="btn-primary">Submit</button>
                <button type="reset" class="btn-secondary">Reset</button>
            </fieldset>
            @if (!Model.IsAppendixFrozen)
            {
                <button type="submit" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")" class="btn-warning">Freeze Data</button>
            }
        </div>
    </form>

    <div class="overflow-x-auto p-5">
        <table class="demo-table min-w-full text-sm">
            <thead>
                <tr>
                    <th class="SrNo">S.No.</th><th>Title of the User Charge</th><th>Services for which the user charge is levied</th>
                    <th>Organisation/Department</th><th>Total Revenue in @y1</th><th>Total Revenue in @y2</th>
                    <th>Total Revenue in @y3</th><th>Remarks</th>
                    @if (!locked)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Count == 0)
                {
                    <tr><td colspan="9" class="empty-state-cell">No records to display.</td></tr>
                }
                else
                {
                    for (var i = 0; i < Model.Records.Count; i++)
                    {
                        var r = Model.Records[i];
                        <tr class="@(r.IsFrozen ? "opacity-70" : "")">
                            <td class="SrNo">@(i + 1)</td>
                            <td>@r.TitleOfCharge</td>
                            <td>@r.Service</td>
                            <td>@r.OrgDept</td>
                            <td>@r.TotalRevenueY1</td>
                            <td>@r.TotalRevenueY2</td>
                            <td>@r.TotalRevenueY3</td>
                            <td>@r.Remarks</td>
                            @if (!locked)
                            {
                                <td>
                                @if (!r.IsFrozen)
                                {
                                    <div class="flex gap-2">
                                        <button type="button" class="table-icon-btn table-action-neutral" title="Edit"
                                                data-action="edit-appendix-via-record"
                                                data-id="@r.Id"
                                                data-title-of-charge="@r.TitleOfCharge"
                                                data-service="@r.Service"
                                                data-org-dept="@r.OrgDept"
                                                data-rate-of-charge="@r.RateOfCharge"
                                                data-date-of-rate-fixation="@(r.DateOfRateFixation?.ToString("yyyy-MM-dd"))"
                                                data-fixation-statute="@r.FixationStatute"
                                                data-total-revenue-y1="@r.TotalRevenueY1"
                                                data-total-revenue-y2="@r.TotalRevenueY2"
                                                data-total-revenue-y3="@r.TotalRevenueY3"
                                                data-competent-authority="@r.CompetentAuthority"
                                                data-period-of-fixation="@r.PeriodOfFixation"
                                                data-salary="@r.Salary"
                                                data-office-expenses="@r.OfficeExpenses"
                                                data-other-expenses="@r.OtherExpenses"
                                                data-is-collection-cost-higher="@r.IsCollectionCostHigher.ToString().ToLowerInvariant()"
                                                data-is-trans-cost-higher="@r.IsTransCostHigher.ToString().ToLowerInvariant()"
                                                data-remarks="@r.Remarks">
                                            <i data-lucide="pencil"></i>
                                        </button>
                                        <form method="post" asp-action="DeleteAppendixVIA" data-confirm="Delete this record? This cannot be undone.">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <input type="hidden" name="demandId" value="@Model.DemandId" />
                                            <button type="submit" class="table-icon-btn table-action-danger" title="Delete"><i data-lucide="trash-2"></i></button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
