@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVIIBViewModel
@{
    var y = Model.FinancialYear;
    var yMinus1 = Model.PriorFinancialYear;
    var yMinus2 = Model.PriorPriorFinancialYear;
    var yMinus3 = Model.YearOffset(-3);
    ViewData["Title"] = ViewData["Title"] ?? $"Appendix VII-B : Commercial receipts of Departmentally run commercial undertakings and its revenue expenditure in BE {y}";
    var locked = Model.IsEntryLocked;
    var canEnter = Model.HasEntryPermission && !locked;

    // "Approved design for all appendixes" (2026-09-10) - same drawer/grid theme as Appendix VI/
    // VII-A (see ubis2_appendix_redesign_reuse_shared_files memory). Every existing field,
    // validation, the Scheme -> Major Head AJAX cascade, the Scheme+MajorHead+TransactionType
    // BE/Actuals auto-load (loadAppendixVIIBBeActuals), the RE-BE IncreasedBE recalc
    // (recalcAppendixVIIBIncreasedBE), the permission framework gating and the dup check
    // (Demand+FY+Scheme+MajorHead+TransactionType) all stay exactly as-is - all still owned by
    // PreBudget-control-binding.js, which keys off form id appendixVIIBForm, the NewRecord_* field
    // ids, data-action="edit-appendix-viib-record", and the grid table id appendixVIIBGrid
    // (kept below so filterAppendixVIIBGrid keeps working). Header Nil/Freeze buttons match
    // Appendix VI-A's own gating; row action menu = Edit / Delete only.
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="file-spreadsheet" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix VII-B</h2>
                        <span id="viibRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span>
                    @if (Model.IsAppendixFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else if (Model.IsNilSubmitted)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>NIL
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Commercial receipts of Departmentally run commercial undertakings and its revenue expenditure in BE @y</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @if (Model.Records.Count == 0 && canEnter)
                {
                    <button type="submit" form="appendixVIIBForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (Model.Records.Count > 0 && canEnter)
                {
                    <button type="submit" form="appendixVIIBForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (canEnter)
                {
                    <button type="button" data-action="open-appendix-viib-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_AppendixPermissionAlert", Model)

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
        <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="viibSearchInput" type="search" placeholder="Search undertaking, major head, transaction type..." class="search-control" /></div>
            <div class="flex items-center gap-2">
                
                <div class="relative">
                    <button id="viibColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="viibColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="viibColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="majorhead" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Major Head</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="transtype" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Type of Transaction</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="acty3" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals @yMinus3</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="acty2" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals @yMinus2</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="be" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">BE @yMinus1</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="septprev" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals Sept @(yMinus2.Split('-')[0])</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="sept" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals Sept @(yMinus1.Split('-')[0])</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="re" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">RE @yMinus1</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="incbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Increase/Decrease over BE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="nbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">BE @y</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-viib-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                <button id="viibExportButton" type="button" data-action="toggle-appendix-viib-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="viibExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="viibExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-viib" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-viib" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-viib" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="viibGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="appendixVIIBGrid" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th class="w-12 px-2 py-3 text-center SrNo">S.No.</th>
                        <th class="px-2 py-3 text-left"><button type="button" data-sort-key="scheme" class="flex items-center gap-1">Departmental Commercial Undertaking <i data-lucide="chevrons-up-down" class="h-3.5 w-3.5 shrink-0"></i></button></th>
                        <th data-column="majorhead" class="px-2 py-3 text-left">Major Head</th>
                        <th data-column="transtype" class="px-2 py-3 text-left"><button type="button" data-sort-key="transtype" class="flex items-center gap-1">Type of Transaction <i data-lucide="chevrons-up-down" class="h-3.5 w-3.5 shrink-0"></i></button></th>
                        <th data-column="acty3" class="px-2 py-3 text-right">Actuals @yMinus3</th>
                        <th data-column="acty2" class="px-2 py-3 text-right">Actuals @yMinus2</th>
                        <th data-column="be" class="px-2 py-3 text-right">BE @yMinus1</th>
                        <th data-column="septprev" class="px-2 py-3 text-right">Actuals Sept @(yMinus2.Split('-')[0])</th>
                        <th data-column="sept" class="px-2 py-3 text-right">Actuals Sept @(yMinus1.Split('-')[0])</th>
                        <th data-column="re" class="px-2 py-3 text-right">RE @yMinus1</th>
                        <th data-column="incbe" class="px-2 py-3 text-right">Increase(+)/Decrease(-) over BE @yMinus1</th>
                        <th data-column="nbe" class="px-2 py-3 text-right">BE @y</th>
                        @if (!locked)
                        {
                            <th class="w-16 px-2 py-3 text-center">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="viibGridBody" class="divide-y divide-slate-100">
                    @if (Model.Records.Count == 0)
                    {
                        <tr><td colspan="13" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Records.Count; i++)
                        {
                            var r = Model.Records[i];
                            var status = r.IsFrozen ? "Frozen" : "Active";
                            var searchHaystack = string.Join(" ", new[] { r.SchemeName, r.MajorHeadCode, r.TransactionType, status });
                            <tr data-row data-status="@status" data-record-id="@r.Id" data-search="@searchHaystack"
                                data-scheme-id="@r.SchemeId" data-major-head-id="@r.MajorHeadId" data-transaction-type="@r.TransactionType"
                                data-sort-scheme="@r.SchemeName" data-sort-transtype="@r.TransactionType"
                                class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                                <td class="relative SrNo px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>
                                    @if (r.IsFrozen)
                                    {
                                        <span class="absolute left-0 top-0 bottom-0 w-1 bg-slate-700" title="Frozen record"></span>
                                    }
                                    @(i + 1)
                                </td>
                                <td class="break-words px-2 py-3 text-left text-xs font-semibold text-slate-700">@(r.SchemeName ?? "-")</td>
                                <td data-column="majorhead" class="break-words px-2 py-3 text-left text-xs text-slate-700">@(r.MajorHeadCode ?? "-")</td>
                                <td data-column="transtype" class="break-words px-2 py-3 text-left text-xs text-slate-700">@r.TransactionType</td>
                                <td data-column="acty3" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.ActualsY2?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="acty2" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.ActualsY1?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="be" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.BE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="septprev" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.ActualsUptoSeptPrevYear?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="sept" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.ActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="re" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.RE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="incbe" class="tabular px-2 py-3 text-right text-xs text-slate-800">@(r.IncreasedBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="nbe" class="tabular px-2 py-3 text-right text-xs font-bold text-slate-800">@(r.NBE?.ToString("0.00") ?? "0.00")</td>
                                @if (!locked)
                                {
                                    <td class="grid-action-cell px-2 py-3 text-center">
                                        @if (!r.IsFrozen && Model.CanEdit)
                                        {
                                            <div class="relative inline-block">
                                                <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                        data-action-id="@r.Id" aria-label="Actions for record @(i + 1)" aria-haspopup="true">
                                                    <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                                </button>
                                                <div id="viib-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                    <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                            data-action="edit-appendix-viib-record"
                                                            data-id="@r.Id"
                                                            data-scheme-id="@r.SchemeId"
                                                            data-transaction-type="@r.TransactionType"
                                                            data-major-head-id="@r.MajorHeadId"
                                                            data-major-head-code="@r.MajorHeadCode"
                                                            data-actuals-y1="@r.ActualsY1"
                                                            data-actuals-upto-sept="@r.ActualsUptoSept"
                                                            data-actuals-upto-sept-prev-year="@r.ActualsUptoSeptPrevYear"
                                                            data-re="@r.RE"
                                                            data-nbe="@r.NBE">
                                                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                    </button>
                                                    @if (Model.CanDelete)
                                                    {
                                                        <button type="button" data-action="delete-appendix-viib-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                            <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                        </button>
                                                        <form method="post" asp-action="DeleteAppendixVIIB" class="hidden">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@r.Id" />
                                                            <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (r.IsFrozen)
                                        {
                                            <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="viibEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-viib-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="viibRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="viibTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="viibPageSize" data-action="change-appendix-viib-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="viibPrevBtn" type="button" data-action="appendix-viib-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="viibPageNumbers" class="flex items-center gap-1"></div>
                <button id="viibNextBtn" type="button" data-action="appendix-viib-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <div id="viibDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <aside id="viibDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Commercial undertaking form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="viibDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                    @* <p id="viibDrawerSubtitle" class="text-[11px] text-slate-500">Create a new record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixVIIB" id="appendixVIIBForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixVIIB-@Model.DemandId" data-selected-scheme-id="@Model.NewRecord.SchemeId" data-selected-major-head-id="@Model.NewRecord.MajorHeadId" data-selected-transaction-type="@Model.NewRecord.TransactionType" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="VII-B" />
            <input type="hidden" name="appendixId" value="@Model.AppendixId" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@(canEnter ? null : "disabled")" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                @if (Model.IsNilSubmitted)
                {
                    <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                }
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Undertaking &amp; Classification</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-1">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Departmental Commercial Undertaking <span class="text-red-500">*</span></p>
                            <select class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" required asp-for="NewRecord.SchemeId">
                                <option value="">Select</option>
                                @foreach (var s in Model.Schemes)
                                {
                                    <option value="@s.SchemeId">@s.SchemeName</option>
                                }
                            </select>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Major Head <span class="text-red-500">*</span></p>
                            <select class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" required asp-for="NewRecord.MajorHeadId" disabled data-role="major-head-select">
                                <option value="">Select</option>
                            </select>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Type of Transaction <span class="text-red-500">*</span></p>
                            <select class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" required asp-for="NewRecord.TransactionType">
                                <option value="">Select</option>
                                @foreach (var t in Model.TransactionTypes)
                                {
                                    <option value="@t.Name">@t.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </section>

                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Financial Details</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals @yMinus3</p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-slate-100 px-3 text-right text-sm font-semibold text-slate-600 outline-none" type="number" step="0.01" required readonly asp-for="NewRecord.ActualsY2" title="Auto-loaded from SBEData for the selected Scheme/Major Head/Transaction Type" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals @yMinus2 <span class="text-red-500">*</span></p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" required asp-for="NewRecord.ActualsY1" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">BE @yMinus1</p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-slate-100 px-3 text-right text-sm font-semibold text-slate-600 outline-none" type="number" step="0.01" required readonly asp-for="NewRecord.BE" title="Auto-loaded from SBEData for the selected Scheme/Major Head/Transaction Type" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals Up to 9/@(yMinus2.Split('-')[0]) <span class="text-red-500">*</span></p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" required asp-for="NewRecord.ActualsUptoSeptPrevYear" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals Up to 9/@(yMinus1.Split('-')[0]) <span class="text-red-500">*</span></p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" required asp-for="NewRecord.ActualsUptoSept" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">RE @yMinus1 <span class="text-red-500">*</span></p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" required asp-for="NewRecord.RE" title="Filled manually" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Increase(+)/Decrease(-) over BE @yMinus1</p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-slate-100 px-3 text-right text-sm font-semibold text-slate-600 outline-none" type="number" step="0.01" readonly asp-for="NewRecord.IncreasedBE" title="Computed: RE - BE" />
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">BE @y <span class="text-red-500">*</span></p>
                            <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" required asp-for="NewRecord.NBE" />
                        </div>
                    </div>
                </section>
            </div>

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                    <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-viib-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <div id="viibToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="viibToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="viibToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="viibToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="viibToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <div id="viibDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="viibDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="viibDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                    <p id="viibDeleteRecordName" class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800"></p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="viibCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="viibConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
