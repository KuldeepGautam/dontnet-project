@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixIIIAViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix III-A : TSA Assignment and Expenditure";
    var locked = Model.IsEntryLocked;
    // Client requirement 2026-08-31: "TSA Assignment as on 30th Sept, 2025-2026" -> "... 2025" -
    // just the opening year of the FY range, not the full "2025-2026" span.
    var septYear = Model.PriorFinancialYear.Split('-')[0];

    // "Approved design for all appendixes" (2026-09-09) - same drawer/grid theme reused verbatim
    // (see ubis2_appendix_redesign_reuse_shared_files memory). Like Appendix III, III-A permits any
    // number of records (keyed per free-text Entity Name, not one-per-Demand) - Add stays available
    // whenever the appendix isn't locked. EntityName stays a free-text input (not a dropdown, despite
    // the design mockup's fixed-option <select>) - it's matched against III-A's own prior-year history
    // for the BE auto-load (GetAppendixIIIABePreviousYear, keyed by exact-text match), same as today.
    // All validation rules (BE/TsaAssignment/ActualExpenditure required, min=0, BR-04/BR-05 ceiling
    // checks on submit) and the Unspent Assignment live recalc are unchanged - still owned by
    // PreBudget-control-binding.js's loadAppendixIIIABePreviousYear/recalcAppendixIIIAUnspentAssignment/
    // populateSimpleEntryForm's III-A branch.
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="file-spreadsheet" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix III-A</h2>
                        @* <span id="iiiaRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span> *@
                        @if (Model.IsAppendixFrozen)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="freezedot"></span>Freezed
                            </span>
                        }
                        else if (Model.IsNilSubmitted)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="freezedot"></span>NIL
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="bluedot"></span>In Progress
                            </span>
                        }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">TSA Assignment and Expenditure</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @if (!Model.IsAppendixFrozen && !locked)
                {
                    <button type="submit" form="appendixIIIAForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!locked)
                {
                    <button type="button" data-action="open-appendix-iiia-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
    <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="iiiaSearchInput" type="search" placeholder="Search" class="search-control" /></div>
            <div class="flex items-center gap-2">

                <div class="relative">
                    <button id="iiiaColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiiaColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="iiiaColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="be" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">BE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="tsa" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">TSA Assignment</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="actual" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actual Expenditure</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="unspent" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Unspent Assignment</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="Date of Last Assignment" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Date of Last Assignment</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="Amount of Last Assignment" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Amount of Last Assignment</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-iiia-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <button id="iiiaExportButton" type="button" data-action="toggle-appendix-iiia-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiiaExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="iiiaExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-iiia" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-iiia" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-iiia" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="iiiaGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="iiiaChargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head">
                    <!-- Row 1: Main Headers -->
                    <tr class="data-grid__header-row">
                        <th rowspan="2" class="w-[4%] px-2 py-3 text-center">S.No.</th>
                        <th rowspan="2" class="w-[16%] px-2 py-3 text-left">
                            <button type="button" data-sort-key="entity" class="flex items-center gap-1">
                                Name of the Entity
                            </button>
                        </th>
                        <th rowspan="2" data-column="be" class="w-[9%] px-2 py-3 text-right">BE @Model.PriorFinancialYear</th>
                        <th rowspan="2" data-column="tsa" class="w-[11%] px-2 py-3 text-right">TSA Assignment<br>as on 30-Sept @septYear</th>
                        <th rowspan="2" data-column="actual" class="w-[11%] px-2 py-3 text-right">Actual Expenditure<br>upto Sept @Model.PriorFinancialYear?.Split('-').FirstOrDefault()?.Trim() </th>
                        <th rowspan="2" data-column="unspent" class="w-[10%] px-2 py-3 text-right">Unspent<br>Assignment</th>

                        <th rowspan="2" data-column="Date of Last Assignment" class="w-[8%] px-2 py-3 text-center">Date of Last Assignment</th>
                        <th rowspan="2" data-column="Amount of Last Assignment" class="w-[7%] px-2 py-3 text-right">Amount of Last Assignment</th>

                        @if (!locked)
                        {
                            <th rowspan="2" class="w-[6%] px-2 py-3 text-center">Action</th>
                        }
                    </tr>

                    <!-- Row 2 removed: Date and Amount moved to main header row -->
                </thead>
                <tbody id="iiiaGridBody" class="divide-y divide-slate-100">
                    @if (Model.Records.Count == 0)
                    {
                        <tr><td colspan="8" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Records.Count; i++)
                        {
                            var r = Model.Records[i];
                            @* Appendix III-A has no per-row freeze - freezing is template-level only
                               (header "Freeze Data" -> FreezeAppendixTemplate, reflected in `locked`).
                               The record DTO's IsFrozen (a leftover from the old FreezeAppendixIIIABulk
                               path) is deliberately not used here: it was showing rows as "Frozen"
                               with no way to edit them after a normal Save. (client report 2026-09-10) *@
                            // Client requirement 2026-09-18: search must include every visible
                            // numeric/date column, not just Name of the Entity - same rule already
                            // applied to Appendix I-A/II/III's grids.
                            var searchHaystack = string.Join(" ", new[]
                            {
                                r.EntityName,
                                r.BE?.ToString("0.00") ?? "0.00",
                                r.TsaAssignmentAsOnSept?.ToString("0.00") ?? "0.00",
                                r.ActualExpenditureUptoSept?.ToString("0.00") ?? "0.00",
                                r.UnspentAssignment?.ToString("0.00") ?? "0.00",
                                r.DateOfLastAssignment?.ToString("dd-MMM-yyyy") ?? "-",
                                r.AmountOfLastAssignment?.ToString("0.00") ?? "0.00"
                            });
                            <tr data-row data-search="@searchHaystack" data-sort-entity="@r.EntityName"
                                class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60">
                                <td class="relative row-sr-no SrNo px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>
                                    @(i + 1)
                                </td>
                                <td class="px-2 py-3 text-left text-xs font-semibold text-slate-700">@r.EntityName</td>
                                <td data-column="be" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.BE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="tsa" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.TsaAssignmentAsOnSept?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="actual" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.ActualExpenditureUptoSept?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="unspent" class="tabular px-2 py-3 text-right text-xs font-bold text-slate-800">@(r.UnspentAssignment?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="Date of Last Assignment" class="px-2 py-3 text-center text-[11px] text-slate-600">
                                    @(r.DateOfLastAssignment?.ToString("dd-MMM-yyyy") ?? "-")

                                </td>
                                <td data-column="Amount of Last Assignment" class="px-2 py-3 text-right text-[11px] text-slate-600">

                                    <span class="tabular font-semibold text-slate-800">@(r.AmountOfLastAssignment?.ToString("0.00") ?? "0.00")</span>
                                </td>
                                @if (!locked)
                                {
                                    <td class="grid-action-cell px-2 py-3 text-center">
                                        <div class="relative inline-block">
                                            <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                    data-action-id="@r.Id" aria-label="Actions for record @(i + 1)" aria-haspopup="true">
                                                <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                            </button>
                                            <div id="iiia-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                        data-action="edit-appendix-iiia-record"
                                                        data-id="@r.Id"
                                                        data-entity-name="@r.EntityName"
                                                        data-be="@r.BE"
                                                        data-tsa-assignment-as-on-sept="@r.TsaAssignmentAsOnSept"
                                                        data-actual-expenditure-upto-sept="@r.ActualExpenditureUptoSept"
                                                        data-date-of-last-assignment="@(r.DateOfLastAssignment?.ToString("yyyy-MM-dd"))"
                                                        data-amount-of-last-assignment="@r.AmountOfLastAssignment">
                                                    <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                </button>
                                                <button type="button" data-action="delete-appendix-iiia-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                </button>
                                                <form method="post" asp-action="DeleteAppendixIIIA" class="hidden">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="iiiaEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-iiia-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="iiiaRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="iiiaTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="iiiaPageSize" data-action="change-appendix-iiia-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="iiiaPrevBtn" type="button" data-action="appendix-iiia-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="iiiaPageNumbers" class="flex items-center gap-1"></div>
                <button id="iiiaNextBtn" type="button" data-action="appendix-iiia-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-iiia-drawer" here, same fix already
         proven for VI-A/III. Only the header's X button and the footer's Cancel button close it. -->
    <div id="iiiaDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action as before) -->
    <aside id="iiiaDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="TSA Assignment and Expenditure form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="iiiaDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                      @* <p id="iiiaDrawerSubtitle" class="text-[11px] text-slate-500">Create a new record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixIIIA" id="appendixIIIAForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixIIIA-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="III-A" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
                <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                    @if (Model.IsNilSubmitted)
                    {
                        <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                    }
                    <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                        <div class="grid pt-4 pl-3 md:grid-cols-1">
                            <h3 class="text-sm font-bold text-slate-800">Entity</h3>
                        </div>
                        <div class="grid gap-3 p-4 md:grid-cols-1">
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Name of the Entity <span class="text-red-500">*</span></p>
                                <input class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="text" maxlength="250" required asp-for="NewRecord.EntityName" />
                            </div>
                        </div>
                    </section>

                    <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                        <div class="grid pt-4 pl-3 md:grid-cols-1">
                            <h3 class="text-sm font-bold text-slate-800">Financial Details</h3>
                        </div>
                        <div class="grid gap-3 p-4 md:grid-cols-2">
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">BE @Model.PriorFinancialYear <span class="text-red-500">*</span></p>
                                <div class="relative mt-2">
                                    <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                    <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.BE" title="Auto-loaded from this Entity's own Appendix III-A record one year prior - editable" />
                                </div>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">TSA Assignment as on 30th Sept, @septYear <span class="text-red-500">*</span></p>
                                <div class="relative mt-2">
                                    <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                    <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.TsaAssignmentAsOnSept" />
                                </div>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">Actual Expenditure upto Sept, @Model.PriorFinancialYear <span class="text-red-500">*</span></p>
                                <div class="relative mt-2">
                                    <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                    <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.ActualExpenditureUptoSept" />
                                </div>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">Unspent Assignment</p>
                                <div class="relative mt-2">
                                    <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                    <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none" type="text" id="iiiaUnspentAssignment" readonly tabindex="-1" title="TSA Assignment as on 30th Sept minus Actual Expenditure upto Sept - calculated automatically" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                        <div class="grid pt-4 pl-3 md:grid-cols-1">
                            <h3 class="text-sm font-bold text-slate-800">Last Assignment</h3>
                        </div>
                        <div class="grid gap-3 p-4 md:grid-cols-2">
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">Date of Last Assignment <span class="text-red-500">*</span></p>
                                <input class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" required asp-for="NewRecord.DateOfLastAssignment" />
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">Amount of Last Assignment <span class="text-red-500">*</span></p>
                                <div class="relative mt-2">
                                    <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                    <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.AmountOfLastAssignment" />
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                    <div class="flex items-center gap-2">
                        <button type="reset" id="appendixIIIAReset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                        <button type="button" data-action="close-appendix-iiia-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                        <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                    </div>
                </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="iiiaToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="iiiaToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="iiiaToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="iiiaToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="iiiaToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="iiiaDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="iiiaDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="iiiaDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="iiiaCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="iiiaConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
