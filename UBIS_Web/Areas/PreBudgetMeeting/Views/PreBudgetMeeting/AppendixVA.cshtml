@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVAViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix V-A : Grant in Aid to Autonomous and other Bodies";
    var yMinus2 = Model.PriorPriorFinancialYear;
    var yMinus1 = Model.PriorFinancialYear;
    var y = Model.FinancialYear;
    var vaLocked = Model.IsVALocked;

    // Re-design 2026-09-14 (designer reference: UBIS-drawer-070926 "Appendix-V-A.html") - split out
    // of the former tabbed AppendixVGroup.cshtml (which covered V-A/V-B/V-C in one page) into its
    // own standalone page, matching the convention Appendix IV/IV-A/IV-B were just moved to. Fields/
    // cascades/duplicate-checks/Save-Freeze-Delete actions are unchanged - only the shell moved from
    // a tab panel to a full page, and Export/Columns were added (neither existed on the tabbed
    // page). AutonomousBodyId stays a real DB-backed <select> (dbo.M_AutonomousBody via
    // Model.AutonomousBodies) - the designer mockup's plain-text "Name of Autonomous Body" field is
    // its own simplified static demo data, not a real field-type instruction (same convention as
    // every other appendix's designer mockup this session, e.g. Appendix VI's Receipt Type).
}

<div class="ubis-modern-appendix">
    <div class="mb-4 flex items-center justify-between">
        <p class="text-xs font-bold uppercase tracking-wide text-red-600">Amount in Crores of Rupees</p>
        <button type="button" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" data-action="view-consolidated-report">View Consolidated Report</button>
    </div>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="landmark" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix V-A</h2>
                        <span id="vaRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.VARecords.Count Record@(Model.VARecords.Count == 1 ? "" : "s")</span>
                    @if (Model.IsVAFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Grant in Aid to Autonomous and other Bodies</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                @if (!Model.IsVAFrozen)
                {
                    <button type="submit" form="appendixVAForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!vaLocked)
                {
                    <button type="button" data-action="open-appendix-va-add-drawer" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="vaSearchInput" type="search" placeholder="Search autonomous body..." class="search-control" /></div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <button id="vaColumnsButton" type="button" data-action="toggle-appendix-va-columns-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vaColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="vaColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-56 overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="body" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Name of Autonomous Body</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="general" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">GiA General (A) B.E. @y</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="cca" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">GiA for Creation of Capital Assets (B) B.E. @y</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="salary" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">GiA for Salary (C) B.E. @y</label>
                        <div class="mt-1 border-t border-slate-100 pt-1"><button type="button" data-action="reset-appendix-va-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button></div>
                    </div>
                </div>
                <div class="relative">
                    <button id="vaExportButton" type="button" data-action="toggle-appendix-va-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vaExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="vaExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-va" data-format="pdf" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600"><i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i><span>PDF</span></button>
                        <button type="button" data-action="export-appendix-va" data-format="excel" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600"><i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i><span>Excel</span></button>
                        <button type="button" data-action="export-appendix-va" data-format="csv" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600"><i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i><span>CSV</span></button>
                    </div>
                </div>
            </div>
        </div>
        <div id="vaGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="vaChargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th class="w-[4%] px-2 py-3 text-center">S.No.</th>
                        <th data-column="body" class="w-[26%] px-2 py-3"><button type="button" data-sort-key="body" class="flex items-center gap-1.5">Name of Autonomous Body</button></th>
                        <th data-column="general" class="w-[18%] px-2 py-3 text-right">GiA General (A)<br>B.E. @y</th>
                        <th data-column="cca" class="w-[18%] px-2 py-3 text-right">GiA for Creation of<br>Capital Assets (B) B.E. @y</th>
                        <th data-column="salary" class="w-[18%] px-2 py-3 text-right">GiA for Salary (C)<br>B.E. @y</th>
                        @if (!vaLocked)
                        {
                            <th class="w-[8%] px-2 py-3 text-center" data-export-exclude="true">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="vaGridBody" class="divide-y divide-slate-100">
                    @if (Model.VARecords.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.VARecords.Count; i++)
                        {
                            var r = Model.VARecords[i];
                            var abName = Model.AutonomousBodies.FirstOrDefault(a => a.AutonomousBodyId == r.AutonomousBodyId)?.Name ?? r.AutonomousBodyId.ToString();
                            var status = r.IsFrozen ? "Frozen" : "Active";
                            <tr data-row data-status="@status" data-search="@abName @status" data-sort-body="@abName"
                                class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                                <td class="px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>@(i + 1)</td>
                                <td data-column="body" class="break-words px-2 py-3 text-xs font-bold text-slate-800">@abName</td>
                                <td data-column="general" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.GiaGeneralNBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="cca" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.GiaCcaNBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="salary" class="tabular px-2 py-3 text-right text-xs font-bold text-indigo-800">@(r.GiaSalaryNBE?.ToString("0.00") ?? "0.00")</td>
                                @if (!vaLocked)
                                {
                                    <td class="grid-action-cell px-2 py-3 text-center" data-export-exclude="true">
                                        @if (!r.IsFrozen)
                                        {
                                            <div class="relative inline-block">
                                                <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100" data-action-id="@r.Id" aria-label="Actions for @abName" aria-haspopup="true"><i data-lucide="more-horizontal" class="h-4 w-4"></i></button>
                                                <div id="va-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                    <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                            data-action="edit-appendix-va-record" data-id="@r.Id" data-autonomous-body-id="@r.AutonomousBodyId"
                                                            data-gia-general-actuals="@r.GiaGeneralActuals" data-gia-general-actuals-upto-sept-prev-year="@r.GiaGeneralActualsUptoSeptPrevYear" data-gia-general-be="@r.GiaGeneralBE" data-gia-general-actuals-upto-sept="@r.GiaGeneralActualsUptoSept" data-gia-general-re="@r.GiaGeneralRE" data-gia-general-nbe="@r.GiaGeneralNBE"
                                                            data-gia-cca-actuals="@r.GiaCcaActuals" data-gia-cca-actuals-upto-sept-prev-year="@r.GiaCcaActualsUptoSeptPrevYear" data-gia-cca-be="@r.GiaCcaBE" data-gia-cca-actuals-upto-sept="@r.GiaCcaActualsUptoSept" data-gia-cca-re="@r.GiaCcaRE" data-gia-cca-nbe="@r.GiaCcaNBE"
                                                            data-gia-salary-actuals="@r.GiaSalaryActuals" data-gia-salary-actuals-upto-sept-prev-year="@r.GiaSalaryActualsUptoSeptPrevYear" data-gia-salary-be="@r.GiaSalaryBE" data-gia-salary-actuals-upto-sept="@r.GiaSalaryActualsUptoSept" data-gia-salary-re="@r.GiaSalaryRE" data-gia-salary-nbe="@r.GiaSalaryNBE" data-gia-salary-total="@r.GiaSalaryTotal">
                                                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                    </button>
                                                    <button type="button" data-action="delete-appendix-va-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50"><i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete</button>
                                                    <form method="post" asp-action="DeleteAppendixVA" class="hidden">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="demandId" value="@Model.DemandId" /></form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div id="vaEmptyState" class="@(Model.VARecords.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400"><i data-lucide="search-x" class="h-5 w-5"></i></div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.VARecords.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
        </div>
        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">Showing <span id="vaRangeText" class="font-semibold text-slate-700">@(Model.VARecords.Count == 0 ? "0" : "1–" + Model.VARecords.Count)</span> of <span id="vaTotalText" class="font-semibold text-slate-700">@Model.VARecords.Count</span> records</div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">Rows:
                    <select id="vaPageSize" data-action="change-appendix-va-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select>
                </label>
                <button id="vaPrevBtn" type="button" data-action="appendix-va-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50"><i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous</button>
                <div id="vaPageNumbers" class="flex items-center gap-1"></div>
                <button id="vaNextBtn" type="button" data-action="appendix-va-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i></button>
            </div>
        </div>
    </section>

    <div id="vaDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>
    <aside id="vaDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Grant in aid form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="vaDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                    @* <p id="vaDrawerSubtitle" class="text-[11px] text-slate-500">Create a new record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2"><span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span><span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span></div>
                </div>
            </div>
        </div>
        <form method="post" autocomplete="off" asp-action="SaveAppendixVA" id="appendixVAForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixVA-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="V-A" />
            <input type="hidden" asp-for="VANewRecord.Id" />
            <fieldset disabled="@vaLocked" style="border:none;margin:0;padding:0;display:contents;">
                <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                    <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                        <div class="grid gap-4 p-4">
                            <div>
                                <label class="mb-1.5 block text-xs font-semibold text-slate-700">Name of Autonomous Body <span class="text-red-500">*</span></label>
                                <select id="VANewRecord_AutonomousBodyId" class="form-field h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" asp-for="VANewRecord.AutonomousBodyId" required>
                                    <option value="">Select</option>
                                    @foreach (var ab in Model.AutonomousBodies)
                                    {
                                        <option value="@ab.AutonomousBodyId">@ab.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @{
                            (string Prefix, string Category, bool HasSalaryTotal)[] vaSections =
                            {
                            ("GiaGeneral", "GiA General (A)", false),
                            ("GiaCca", "GiA for Creation of Capital Assets (B)", false),
                            ("GiaSalary", "GiA for Salary (C)", true)
                        };
                        }
                        @foreach (var sec in vaSections)
                        {
                            <div class="grid pt-2 pl-3 md:grid-cols-1"><h3 class="text-sm font-bold text-slate-800">@sec.Category</h3></div>
                            <div class="grid gap-3 p-4 md:grid-cols-3">
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actual @yMinus2 <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)Actuals" id="VANewRecord_@(sec.Prefix)Actuals" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "Actuals")?.GetValue(Model.VANewRecord))" />
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals upto 9/@(yMinus2.Split('-')[0]) <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)ActualsUptoSeptPrevYear" id="VANewRecord_@(sec.Prefix)ActualsUptoSeptPrevYear" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "ActualsUptoSeptPrevYear")?.GetValue(Model.VANewRecord))" />
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">B.E. @yMinus1 <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)BE" id="VANewRecord_@(sec.Prefix)BE" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "BE")?.GetValue(Model.VANewRecord))" />
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Actuals upto 9/@(yMinus1.Split('-')[0]) <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)ActualsUptoSept" id="VANewRecord_@(sec.Prefix)ActualsUptoSept" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "ActualsUptoSept")?.GetValue(Model.VANewRecord))" />
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">R.E. @yMinus1 <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)RE" id="VANewRecord_@(sec.Prefix)RE" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "RE")?.GetValue(Model.VANewRecord))" />
                                </div>
                                @* Client mockup (2026-09-14, Appendix-V-A.html): the required "B.E. <Y>" total per
                               category is teal-highlighted - the only value posted straight into NBE/the grid's
                               own displayed total. *@
                                <div class="rounded-xl border border-teal-200 bg-teal-50/30 p-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">B.E. @y <span class="text-red-500">*</span></p>
                                    <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-teal-300 bg-white px-3 text-right text-sm font-bold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required name="VANewRecord.@(sec.Prefix)NBE" id="VANewRecord_@(sec.Prefix)NBE" value="@(Model.VANewRecord.GetType().GetProperty(sec.Prefix + "NBE")?.GetValue(Model.VANewRecord))" />
                                </div>
                                @if (sec.HasSalaryTotal)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 md:col-span-3">
                                        <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Total Salary in @yMinus2 as per accounts of AB <span class="text-red-500">*</span></p>
                                        <input class="NumericData tabular mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="VANewRecord.GiaSalaryTotal" />
                                    </div>
                                }
                                else
                                {
                                    @* Client mockup: General/CCA rows show the same 7-cell shape as the Salary row,
                                   but "Total Salary" only applies to Salary - a plain non-interactive placeholder
                                   keeps the layout consistent without implying these two rows have their own value. *@
                                <div class="rounded-xl border border-slate-200 bg-slate-100/70 p-3 md:col-span-3">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Total Salary in @yMinus2 as per accounts of AB</p>
                                    <div class="mt-2 h-10 w-full rounded-lg border border-slate-200/80 bg-slate-200/50"></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                    <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-va-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                </div>
            </fieldset>
        </form>
    </aside>

    <div id="vaToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full"><i id="vaToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i></div>
        <div class="min-w-0 flex-1"><p id="vaToastTitle" class="text-xs font-bold text-slate-800">Success</p><p id="vaToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p></div>
        <button id="vaToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>
    <div id="vaDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="vaDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600"><i data-lucide="trash-2" class="h-5 w-5"></i></div>
                <div class="min-w-0 flex-1"><h2 id="vaDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2><p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p></div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="vaCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="vaConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
