@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixIIIBViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix III-B : Status of Scheme Appraisal/Approval";
    var locked = Model.IsEntryLocked;

    // New appendix, 2026-09-09 (client instruction, Appendix_Papes_I_to IIIB/Appendix-III-B.html) -
    // same drawer/grid theme as VI-F/III (see ubis2_appendix_redesign_reuse_shared_files memory).
    // Category + Scheme are cascading dropdowns (client instruction 2026-09-10): Category from
    // dbo.M_Category (current FY, SerialNo II/IV) prefetched into Model.Categories; Scheme cascades
    // from the chosen Category via AJAX, same reference shape as Appendix III. Add stays available
    // whenever the appendix isn't locked (duplicate-per-Demand+Category+Scheme is blocked
    // server-side, and the drawer JS disables Save before submit - see appendix-iiib-drawer.js).
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="clipboard-check" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix III-B</h2>
                        <span id="iiibRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span>
                    @if (Model.IsAppendixFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else if (Model.IsNilSubmitted)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>NIL
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Status of Scheme Appraisal/Approval during the XVI Finance Commission Cycle</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @if (Model.Records.Count == 0 && !locked)
                {
                    <button type="submit" form="appendixIIIBForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (Model.Records.Count > 0 && !locked)
                {
                    <button type="submit" form="appendixIIIBForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!locked)
                {
                    <button type="button" data-action="open-appendix-iiib-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
        <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="iiibSearchInput" type="search" placeholder="Search" class="search-control" /></div>
            <div class="flex items-center gap-2">
                
                <div class="relative">
                    <button id="iiibColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiibColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="iiibColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="category" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Category Type</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="appraisal" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Status of Fresh Appraisal/Approval</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="validupto" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Scheme Approval Valid Upto</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="remarks" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Remarks</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-iiib-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <button id="iiibExportButton" type="button" data-action="toggle-appendix-iiib-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiibExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="iiibExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-iiib" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-iiib" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-iiib" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="iiibGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="iiibChargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th class="w-[4%] px-2 py-3 text-center">S.No.</th>
                        <th data-column="category" class="w-[16%] px-2 py-3 text-left"><button type="button" data-sort-key="category" class="flex items-center gap-1">Category Type</button></th>
                        <th class="w-[20%] px-2 py-3 text-left"><button type="button" data-sort-key="scheme" class="flex items-center gap-1">Scheme Name</button></th>
                        <th data-column="appraisal" class="w-[16%] px-2 py-3 text-left"><button type="button" data-sort-key="appraisal" class="flex items-center gap-1">Status of Fresh<br>Appraisal/Approval</button></th>
                        <th data-column="validupto" class="w-[12%] px-2 py-3 text-center">Scheme Approval<br>Valid Upto</th>
                        <th data-column="remarks" class="w-[13%] px-2 py-3 text-left"><button type="button" data-sort-key="remarks" class="flex items-center gap-1">Remarks</button></th>
                        @if (!locked)
                        {
                            <th class="w-[6%] px-2 py-3 text-center">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="iiibGridBody" class="divide-y divide-slate-100">
                    @if (Model.Records.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Records.Count; i++)
                        {
                            var r = Model.Records[i];
                            var status = r.IsFrozen ? "Frozen" : "Active";
                            var searchHaystack = string.Join(" ", new[] { r.CategoryType, r.SchemeName, r.StatusOfFreshAppraisalApproval, r.Remarks, status });
                            <tr data-row data-status="@status" data-search="@searchHaystack" data-record-id="@r.Id"
                                data-sort-category="@r.CategoryType" data-sort-scheme="@r.SchemeName" data-sort-appraisal="@r.StatusOfFreshAppraisalApproval" data-sort-remarks="@r.Remarks"
                                data-dup-category-id="@r.CategoryId" data-dup-scheme-id="@r.SchemeId"
                                class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                                <td class="relative row-sr-no SrNo px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>
                                    @if (r.IsFrozen)
                                    {
                                        <span class="absolute left-0 top-0 bottom-0 w-1 bg-slate-700" title="Frozen record"></span>
                                    }
                                    @(i + 1)
                                </td>
                                <td data-column="category" class="break-words px-2 py-3 text-left text-xs font-semibold text-slate-700">@r.CategoryType</td>
                                <td class="break-words px-2 py-3 text-left text-xs text-slate-700">@r.SchemeName</td>
                                <td data-column="appraisal" class="break-words px-2 py-3 text-left text-xs text-slate-600">@r.StatusOfFreshAppraisalApproval</td>
                                <td data-column="validupto" class="px-2 py-3 text-center text-xs text-slate-600">@(r.SchemeApprovalValidUpto?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td data-column="remarks" class="break-words px-2 py-3 text-left text-xs text-slate-500">
                                    @if (string.IsNullOrEmpty(r.Remarks))
                                    {
                                        @:—
                                    }
                                    else
                                    {
                                        <span class="via-remarks-clamp" title="@r.Remarks">@r.Remarks</span>
                                    }
                                </td>
                                @if (!locked)
                                {
                                    <td class="grid-action-cell px-2 py-3 text-center">
                                        @if (!r.IsFrozen)
                                        {
                                            <div class="relative inline-block">
                                                <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                        data-action-id="@r.Id" aria-label="Actions for record @(i + 1)" aria-haspopup="true">
                                                    <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                                </button>
                                                <div id="iiib-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                    <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                            data-action="edit-appendix-iiib-record"
                                                            data-id="@r.Id"
                                                            data-category-id="@r.CategoryId"
                                                            data-scheme-id="@r.SchemeId"
                                                            data-category-type="@r.CategoryType"
                                                            data-scheme-name="@r.SchemeName"
                                                            data-status-of-fresh-appraisal-approval="@r.StatusOfFreshAppraisalApproval"
                                                            data-scheme-approval-valid-upto="@(r.SchemeApprovalValidUpto?.ToString("yyyy-MM-dd"))"
                                                            data-remarks="@r.Remarks">
                                                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                    </button>
                                                    <button type="button" data-action="delete-appendix-iiib-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                        <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                    </button>
                                                    <form method="post" asp-action="DeleteAppendixIIIB" class="hidden">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="iiibEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-iiib-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="iiibRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="iiibTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="iiibPageSize" data-action="change-appendix-iiib-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="iiibPrevBtn" type="button" data-action="appendix-iiib-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="iiibPageNumbers" class="flex items-center gap-1"></div>
                <button id="iiibNextBtn" type="button" data-action="appendix-iiib-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-iiib-drawer" here, same fix already
         proven for VI-A/III. Only the header's X button and the footer's Cancel button close it. -->
    <div id="iiibDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action as before) -->
    <aside id="iiibDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Scheme Appraisal/Approval Status form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="iiibDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                    @* <p id="iiibDrawerSubtitle" class="text-[11px] text-slate-500">Create a new record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixIIIB" id="appendixIIIBForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixIIIB-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="III-B" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                @if (Model.IsNilSubmitted)
                {
                    <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                }
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid gap-4 p-4">
                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Category <span class="text-red-500">*</span></label>
                            @* Real dropdown (client instruction 2026-09-10): dbo.M_Category rows for
                               the current FY with SerialNo II/IV, prefetched into Model.Categories.
                               Explicit id "NewRecord_IIIBCategoryId" (not the bare asp-for id) - both
                               Appendix III's Balance Type <select> and this one bind to a property
                               named CategoryId, and each appendix's drawer is reparented to
                               document.body and left there across fragment loads, so a user who
                               visits both III and III-B in one session would otherwise have two
                               "NewRecord_CategoryId" elements in the DOM at once. *@
                            <select id="NewRecord_IIIBCategoryId" data-role="iiib-category" class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50 disabled:bg-slate-100 disabled:text-slate-400" required asp-for="NewRecord.CategoryId">
                                <option value="">Select a Category</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Scheme <span class="text-red-500">*</span></label>
                            @* Cascades from the chosen Category via AJAX (GetAppendixIIIBSchemes),
                               same reference shape as Appendix III. Disabled until a Category is
                               picked; options are injected by appendix-iiib-drawer.js. *@
                            <select id="NewRecord_IIIBSchemeId" data-role="iiib-scheme" class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50 disabled:bg-slate-100 disabled:text-slate-400" required disabled asp-for="NewRecord.SchemeId">
                                <option value="">Select a Category first</option>
                            </select>
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Status of Fresh Appraisal/Approval <span class="text-red-500">*</span></label>
                            <input class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="text" maxlength="500" required asp-for="NewRecord.StatusOfFreshAppraisalApproval" />
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Scheme Approval Valid Upto <span class="text-red-500">*</span></label>
                            <input class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="date" required asp-for="NewRecord.SchemeApprovalValidUpto" />
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-slate-700">Remarks <span class="text-red-500">*</span></label>
                            <textarea class="w-full resize-none rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" maxlength="500" rows="4" required placeholder="Enter remarks..." asp-for="NewRecord.Remarks"></textarea>
                        </div>
                    </div>
                </section>
            </div>

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                    <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-iiib-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                    <button type="submit" id="iiibSaveButton" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700 disabled:cursor-not-allowed disabled:opacity-50">Save Record</button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="iiibToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="iiibToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="iiibToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="iiibToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="iiibToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="iiibDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="iiibDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="iiibDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="iiibCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="iiibConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
