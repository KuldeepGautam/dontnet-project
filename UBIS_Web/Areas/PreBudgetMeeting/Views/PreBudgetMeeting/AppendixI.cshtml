@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixIViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix I - Budget and Expenditure Trends";
    var locked = Model.IsEntryLocked;

    // "Approved design for all appendixes" (2026-09-09, UBIS-Pre-budget-html/Appendix-I.html) -
    // same drawer/grid theme as every other redesigned appendix (see
    // ubis2_appendix_redesign_reuse_shared_files memory). Client requirement 2026-09-09: "all data
    // should come in grid. add button is enabled only if current year data is not available" -
    // replaces the old inline 5-year matrix form (client review 2026-08-04/08-06) with a real
    // grid + Add/Edit drawer, while preserving that same business rule underneath: only
    // Model.ActualYear (session FinancialYear - 2) is ever addable/editable; every other year in
    // the 5-year window is settled historical fact, shown read-only with no Edit/Delete.
    var hasActualYearRecord = Model.Records.Any(r => r.FinancialYear == Model.ActualYear);
}

<div class="ubis-modern-appendix">
    <style>
        /* This grid's header is two rows with rowspan/colspan cells. The shared design makes
           every thead th `position: sticky`, and a sticky cell that also spans rows paints
           only its first row's height in Chromium - leaving a transparent strip under
           S.No./Year/Action (client report: "remove gap or border in grid"). This grid does
           not scroll vertically on desktop anyway, so drop sticky for its header entirely -
           the two rows then render as one solid teal band with no gap. */
        #chargesTable thead th { position: static; }
    </style>
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="hero-icon-large">
                    <i data-lucide="file-spreadsheet" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix I</h2>
                        @* <span id="iRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span> *@
                        @if (Model.IsAppendixFrozen)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="freezedot"></span>Freezed
                            </span>
                        }
                        else if (Model.IsNilSubmitted)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="freezedot"></span>NIL
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                                <span class="bluedot"></span>In Progress
                            </span>
                        }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Budget and Expenditure Trends (on Net Basis)</p>
                </div>
            </div>

            <h2>hello world</h2>

            <div class="flex items-center gap-2">
                @if (Model.Records.Count == 0 && !Model.IsAppendixFrozen && !Model.IsNilSubmitted)
                {
                    <button type="submit" form="appendixIForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (!Model.IsAppendixFrozen)
                {
                    <button type="submit" form="appendixIForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!locked)
                {
                    <button type="button" data-action="open-appendix-i-add-drawer"
                            disabled="@(hasActualYearRecord ? "disabled" : null)"
                            title="@(hasActualYearRecord ? $"Data for {Model.ActualYear} already exists - use Edit on that row instead." : null)"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-ubis-navy">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
    @* <section class="mb-5 rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3.5">
            <div class="flex items-center gap-2">
                <i data-lucide="sliders-horizontal" class="h-4 w-4 text-ubis-teal"></i>
                <h3 class="text-sm font-bold text-slate-700">Filter &amp; Context</h3>
            </div>
            <button type="button" data-action="clear-appendix-i-filters" class="text-xs font-semibold text-ubis-blue hover:underline">Clear all</button>
        </div>

        <div class="flex flex-wrap items-end gap-3 p-4">
            <label class="block max-w-sm flex-1">
                <span class="mb-1.5 block text-[10px] font-bold tracking-wide text-slate-500 appendix-filter-label">Search</span>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i>
                    <input id="iSearchInput" type="search" placeholder="Search year..."
                           class="h-10 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-3 text-xs text-slate-700 outline-none placeholder:text-slate-400 focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" />
                </div>
            </label>

            <div class="flex items-end">
                <button type="button" data-action="apply-appendix-i-filters"
                        class="h-10 w-full rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white hover:bg-teal-700 xl:w-auto">
                    Apply
                </button>
            </div>
        </div>
    </section> *@


    <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="positioned-context">
                <i data-lucide="search" class="absolute left-3 top-3 h-4 w-8 text-slate-400"></i>
                <input id="iSearchInput" type="search" placeholder="Search" class="search-control">
            </div>
            @* <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i>
                <input id="iSearchInput" type="search" placeholder="Search..." class="h-10 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-3 text-xs text-slate-700 outline-none placeholder:text-slate-400 focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" />
            </div> *@
            <div class="flex items-center gap-2">
               
                <div class="relative">
                    <button id="iColumnsButton" type="button" class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100" aria-haspopup="true" aria-expanded="false" aria-controls="iColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="iColumnsMenu" class="absolute right-0 top-10 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="revbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Revenue BE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="revre" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Revenue RE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="revact" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Revenue Actuals</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="revactsept" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Revenue Actuals upto Sept</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="capbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Capital BE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="capre" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Capital RE</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="capact" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Capital Actuals</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="capactsept" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Capital Actuals upto Sept</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-i-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <div id="iExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-i" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-i" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-i" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                    <div>
                        <button id="iExportButton" type="button" data-action="toggle-appendix-i-export-menu"
                                class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                aria-haspopup="true" aria-expanded="false" aria-controls="iExportMenu">
                            <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                            <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                        </button>
                    </div>

                </div>
            </div>

        </div>           
      
        <div id="iGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="chargesTable" class="ubis-data-grid">
                @* Grouped two-row header (client instruction 2026-09-10): S.No. / Year / Action
                   span both rows (rowspan); Revenue and Capital are group headers each spanning
                   their 4 sub-columns - BE / RE / Actuals / Actuals upto Sept, in that order.
                   The "Status" column was dropped; the Active/Frozen filter still works off each
                   row's data-status. No inter-group borders (client: "remove gap or border"). *@
                <thead class="ubis-data-grid__head">
                    <tr>
                        <th rowspan="2" >
                            <button type="button" data-sort-key="year" >Year </button>
                        </th>
                        <th colspan="4" >Revenue</th>
                        <th colspan="4" >Capital</th>
                        @if (!locked)
                        {
                            <th rowspan="2" class="w-[6%] px-2 py-3 text-center align-middle">Action</th>
                        }
                    </tr>
                    <tr class="data-grid__header-row">
                        <th data-column="revbe" >BE</th>
                        <th data-column="revre" >RE</th>
                        <th data-column="revact">Actuals</th>
                        <th data-column="revactsept"> Actuals upto Sept</th>
                        <th data-column="capbe" >BE</th>
                        <th data-column="capre" >RE</th>
                        <th data-column="capact">Actuals</th>
                        <th data-column="capactsept" >Actuals upto Sept</th>
                    </tr>
                </thead>
                <tbody id="gridBody" class="divide-y divide-slate-100">
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="10" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            // Client requirement 2026-09-21: "data for prev years if not present must
                            // be shown as 0.00, but not showing" - the redesigned grid was iterating
                            // Model.Records (only years that actually have a saved DB row), silently
                            // dropping any year in the 5-year window with no data at all instead of
                            // showing it with 0.00 placeholders. Model.Rows (built in
                            // BuildAppendixIViewModelAsync) already pads every year in the window with
                            // a blank AppendixIYearRowViewModel when no record exists - switched the
                            // loop to that instead, so every year always renders a row.
                            var r = Model.Rows[i];
                            // Client requirement 2026-09-21 (follow-up #2): "do not use any hash or
                            // line, we need to display 4 rows only if current year data is
                            // unavailable" - the Actual Year row is skipped entirely (not rendered
                            // with a placeholder/dash) until it actually has a saved record; only the
                            // 4 older years render with their usual 0.00 fallback. The Actual Year
                            // row reappears on its own once it has a real saved Id.
                            if (r.IsCurrentYear && !r.Id.HasValue)
                            {
                                continue;
                            }
                            var status = r.IsFrozen ? "Frozen" : "Active";
                            // Client requirement 2026-09-17: the Search box should match numeric
                            // amount columns too, not just Year/Status - deliberately widened from
                            // this repo's usual "text columns only" search convention for this page.
                            var searchHaystack = string.Join(" ", new[]
                            {
                                Model.DemandNo, r.FinancialYear, status,
                                r.RevenueBE?.ToString("0.00"), r.RevenueRE?.ToString("0.00"), r.RevenueActuals?.ToString("0.00"), r.RevenueActualsUptoSept?.ToString("0.00"),
                                r.CapitalBE?.ToString("0.00"), r.CapitalRE?.ToString("0.00"), r.CapitalActuals?.ToString("0.00"), r.CapitalActualsUptoSept?.ToString("0.00")
                            });
                            <tr data-row data-status="@status" data-search="@searchHaystack" data-sort-year="@r.FinancialYear"
                                class="data-grid__row data-grid__row--strong @(r.IsFrozen ? "bg-slate-50" : "")">
                                <td class="text-center">
                                    @if (r.IsFrozen)
                                    {
                                        <span class="absolute left-0 top-0 bottom-0 w-1 bg-slate-700" title="Frozen record"></span>
                                    }
                                 @r.FinancialYear
                                </td>
                                <td data-column="revbe" class=" NumericData">@(r.RevenueBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="revre" class="NumericData">@(r.RevenueRE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="revact" class="NumericData">@(r.RevenueActuals?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="revactsept" class=" NumericData">@(r.RevenueActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="capbe" class=" NumericData">@(r.CapitalBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="capre" class=" NumericData">@(r.CapitalRE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="capact" class=" NumericData">@(r.CapitalActuals?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="capactsept" class=" NumericData">@(r.CapitalActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                @if (!locked)
                                {
                                    <td class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong">
                                        @if (r.IsCurrentYear && r.Id.HasValue && !r.IsFrozen)
                                        {
                                            <div class="relative inline-block">
                                                <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                        data-action-id="@r.Id" aria-label="Actions for @r.FinancialYear" aria-haspopup="true">
                                                    <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                                </button>
                                                <div id="i-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                    <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                            data-action="edit-appendix-i-row"
                                                            data-id="@r.Id"
                                                            data-revenue-be="@r.RevenueBE"
                                                            data-revenue-re="@r.RevenueRE"
                                                            data-revenue-actuals="@r.RevenueActuals"
                                                            data-revenue-actuals-upto-sept="@r.RevenueActualsUptoSept"
                                                            data-capital-be="@r.CapitalBE"
                                                            data-capital-re="@r.CapitalRE"
                                                            data-capital-actuals="@r.CapitalActuals"
                                                            data-capital-actuals-upto-sept="@r.CapitalActualsUptoSept">
                                                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                    </button>

                                                    <button type="button" data-action="delete-appendix-i-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                        <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                    </button>
                                                    <form method="post" asp-action="DeleteAppendixI" class="hidden">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else if (r.Id.HasValue)
                                        {
                                            <span class="text-xs font-semibold text-slate-500">@(r.IsFrozen ? "Frozen" : "Historical")</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <div class="py-4">
                    <p id="remarks" class="text-sm text-slate-700">@Model.Remarks</p>
                </div>
            }
        </div>

        <div id="iEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-i-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="iRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="iTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="iPageSize" data-action="change-appendix-i-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="iPrevBtn" type="button" data-action="appendix-i-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="iPageNumbers" class="flex items-center gap-1"></div>
                <button id="iNextBtn" type="button" data-action="appendix-i-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-i-drawer" here, same fix already
         proven for VI-A. Only the header's X button and the footer's Cancel button close it. -->
    <div id="iDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action as before) -->
    <aside id="iDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Budget and expenditure trends form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="iDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                    @* <p id="iDrawerSubtitle" class="text-[11px] text-slate-500">Enter this year's budget and expenditure trend</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixI" id="appendixIForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixI-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="I" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <input type="hidden" asp-for="NewRecord.FinancialYear" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid grid-cols-1 gap-3 p-4">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Financial Year</p>
                            <input id="iActualYearDisplay" class="w-full border-0 bg-transparent text-sm font-semibold text-slate-800 outline-none" type="text" readonly tabindex="-1" value="@Model.ActualYear" />
                        </div>
                    </div>

                    <div class="grid pt-2 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Revenue (₹ in Crores)</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">BE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.RevenueBE" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">RE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.RevenueRE" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Actuals <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.RevenueActuals" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Actuals upto Sept <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.RevenueActualsUptoSept" />
                            </div>
                        </div>
                    </div>

                    <div class="grid pt-2 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Capital (₹ in Crores)</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">BE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.CapitalBE" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">RE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.CapitalRE" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Actuals <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.CapitalActuals" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Actuals upto Sept <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.CapitalActualsUptoSept" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                        <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-i-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>                    
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="iToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="iToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="iToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="iToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="iToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="iDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="iDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="iDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="iCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="iConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
