@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVIViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix VI : Non Tax Revenue";
    var locked = Model.IsEntryLocked;
    // Client correction 2026-09-14: Actuals is Y-2 (last audited actuals), B.E. is Y-1, Proposed
    // B.E. is Y (the current financial year) - the whole column-year mapping below was previously
    // shifted one year too far forward.
    var yActuals = Model.YearOffset(-2);             // Actuals 2024-2025 (Y-2)
    var yBe = Model.PriorFinancialYear;              // B.E. 2025-2026 (Y-1)
    var yProposed = Model.FinancialYear;             // Proposed B.E. 2026-2027 (Y)
    var septYear = Model.FinancialYear.Split('-')[0]; // "upto 9/2026" - always within the current FY

    // Re-design 2026-09-10 to UBIS-Pre-budget-html/Appendix6.html. Reuses the shared drawer/grid
    // theme (ubis2_appendix_redesign_reuse_shared_files memory). Real changes this pass:
    //  - Receipt Type is now a DB dropdown (Model.ReceiptTypes <- dbo.M_Appendix_VI_ReceiptType) -
    //    the record stores NewRecord.ReceiptTypeId; the microservice resolves the name for
    //    grid/export/search. loadAppendixVIPreviousYearReference is now keyed by ReceiptTypeId.
    //  - "Proposed R.E." became "Proposed B.E." (column ProposedRE renamed to ProposedBE) and two
    //    new optional fields Proposed Collection Q-3 / Q-4 were added; the grid shows them under a
    //    grouped "Proposed" header (colspan).
    // The designer file's own grid <thead> (User Charge / Services / Department / Revenue years) is
    // a copy-paste from Appendix VI-A and is NOT this appendix's content - ignored, as with earlier
    // mockups this session. Add stays available whenever the appendix isn't locked - the
    // duplicate-check keys on ReceiptTypeId + PsuReceiptName (AppendixVIController.CreateRecord).
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="wallet-cards" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix VI</h2>
                        <span id="viRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span>
                    @if (Model.IsAppendixFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else if (Model.IsNilSubmitted)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>NIL
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Non Tax Revenue</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @* Nil/Freeze in the header, next to Add - same real SetNilSubmission/
                   FreezeAppendixTemplate actions and same Records.Count gating as Appendix VI-A
                   (client instruction 2026-09-10: "add NIL and Freeze as in Appendix VI-A"), posted
                   via the HTML `form` attribute since neither button lives inside
                   <form id="appendixVIForm">. Nil only shows while there are no records yet; Freeze
                   only shows once there is at least one record to freeze. Row action menu itself
                   intentionally has no Freeze item (client instruction, same as every other
                   appendix touched this session) - use this header button instead. *@
                @if (Model.Records.Count == 0 && !locked)
                {
                    <button type="submit" form="appendixVIForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (Model.Records.Count > 0 && !locked)
                {
                    <button type="submit" form="appendixVIForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @if (!locked)
                {
                    <button type="button" data-action="open-appendix-vi-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
        <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="viSearchInput" type="search" placeholder="Search receipt type, PSU name, remarks..." class="search-control" /></div>
            <div class="flex items-center gap-2">
                
                <div class="relative">
                    <button id="viColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="viColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="viColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="actuals" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="be" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">B.E.</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="uptosept" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals Upto Sept</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="proposedbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Proposed B.E.</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="q3" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Proposed Collection Q-3</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="q4" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Proposed Collection Q-4</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="remarks" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Remarks</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-vi-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                <button id="viExportButton" type="button" data-action="toggle-appendix-vi-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="viExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="viExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-vi" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-vi" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-vi" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Chromium renders a transparent strip over a sticky <thead> that also uses rowspan/colspan
           (grouped "Proposed" header). Same fix already used on Appendix I - drop the sticky on this
           one table's header cells. *@
        @* Client requirement 2026-09-14: "make column vertically middle align" - the shared
           .ubis-modern-appendix grid CSS forces vertical-align:top on every th/td (higher
           specificity than Tailwind's own align-middle utility class), so this table's own
           th/td need an ID-scoped override rather than relying on that class. *@
        <style>#viChargesTable thead th { position: static; }
        #viChargesTable th, #viChargesTable td { vertical-align: middle; }</style>
        <div id="viGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="viChargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th rowspan="2" class="w-[4%] px-2 py-3 text-center align-middle">S.No.</th>
                        <th rowspan="2" class="w-[12%] px-2 py-3 text-center align-middle"><button type="button" data-sort-key="receipttype" class="mx-auto flex items-center gap-1">Receipt Type</button></th>
                        <th rowspan="2" class="w-[16%] px-2 py-3 text-center align-middle"><button type="button" data-sort-key="psuname" class="mx-auto flex items-center gap-1">PSU/Receipt Name</button></th>
                        <th rowspan="2" data-column="actuals" class="w-[9%] px-2 py-3 text-center align-middle">Actual @yActuals</th>
                        <th rowspan="2" data-column="be" class="w-[9%] px-2 py-3 text-center align-middle">B.E. @yBe</th>
                        <th rowspan="2" data-column="uptosept" class="w-[10%] px-2 py-3 text-center align-middle">Actuals Upto<br>9/@septYear</th>
                        <th colspan="3" class="w-[27%] px-2 py-3 text-center align-middle">Proposed</th>
                        <th rowspan="2" data-column="remarks" class="w-[9%] px-2 py-3 text-center align-middle"><button type="button" data-sort-key="remarks" class="mx-auto flex items-center gap-1">Remarks</button></th>
                        @if (!locked)
                        {
                            <th rowspan="2" class="w-[5%] px-2 py-3 text-center align-middle">Action</th>
                        }
                    </tr>
                    <tr class="data-grid__header-row">
                        <th data-column="proposedbe" class="px-2 py-3 text-center align-middle">B.E.<br>@yProposed</th>
                        <th data-column="q3" class="px-2 py-3 text-center align-middle">Collection<br>Q-3</th>
                        <th data-column="q4" class="px-2 py-3 text-center align-middle">Collection<br>Q-4</th>
                    </tr>
                </thead>
                <tbody id="viGridBody" class="divide-y divide-slate-100">
                    @if (Model.Records.Count == 0)
                    {
                        <tr><td colspan="11" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Records.Count; i++)
                        {
                            var r = Model.Records[i];
                            var status = r.IsFrozen ? "Frozen" : "Active";
                            var searchHaystack = string.Join(" ", new[] { r.ReceiptType, r.PsuReceiptName, r.Remarks, status });
                            <tr data-row data-status="@status" data-search="@searchHaystack" data-record-id="@r.Id"
                                data-sort-receipttype="@r.ReceiptType" data-sort-psuname="@r.PsuReceiptName" data-sort-remarks="@r.Remarks"
                                class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                                <td class="relative row-sr-no SrNo px-2 py-3 text-center text-xs font-semibold text-slate-600" data-srno>
                                    @if (r.IsFrozen)
                                    {
                                        <span class="absolute left-0 top-0 bottom-0 w-1 bg-slate-700" title="Frozen record"></span>
                                    }
                                    @(i + 1)
                                </td>
                                <td class="px-2 py-3 text-left text-xs font-semibold text-slate-700">@r.ReceiptType</td>
                                <td class="break-words px-2 py-3 text-left text-xs text-slate-700">@r.PsuReceiptName</td>
                                <td data-column="actuals" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.Actuals?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="be" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.BE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="uptosept" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.ActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="proposedbe" class="tabular px-2 py-3 text-right text-xs font-bold text-slate-800">@(r.ProposedBE?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="q3" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.ProposedCollectionQ3?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="q4" class="tabular px-2 py-3 text-right text-xs font-semibold text-slate-800">@(r.ProposedCollectionQ4?.ToString("0.00") ?? "0.00")</td>
                                <td data-column="remarks" class="break-words px-2 py-3 text-left text-xs text-slate-500">
                                    @if (string.IsNullOrEmpty(r.Remarks))
                                    {
                                        @:—
                                    }
                                    else
                                    {
                                        <span class="via-remarks-clamp" title="@r.Remarks">@r.Remarks</span>
                                    }
                                </td>
                                @if (!locked)
                                {
                                    <td class="grid-action-cell px-2 py-3 text-center">
                                        @if (!r.IsFrozen)
                                        {
                                            <div class="relative inline-block">
                                                <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                        data-action-id="@r.Id" aria-label="Actions for record @(i + 1)" aria-haspopup="true">
                                                    <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                                </button>
                                                <div id="vi-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                    <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                            data-action="edit-appendix-vi-record"
                                                            data-id="@r.Id"
                                                            data-receipt-type-id="@r.ReceiptTypeId"
                                                            data-psu-receipt-name="@r.PsuReceiptName"
                                                            data-actuals="@r.Actuals"
                                                            data-be="@r.BE"
                                                            data-actuals-upto-sept="@r.ActualsUptoSept"
                                                            data-proposed-be="@r.ProposedBE"
                                                            data-q3="@r.ProposedCollectionQ3"
                                                            data-q4="@r.ProposedCollectionQ4"
                                                            data-remarks="@r.Remarks">
                                                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                    </button>
                                                    <button type="button" data-action="delete-appendix-vi-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                        <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                    </button>
                                                    <form method="post" asp-action="DeleteAppendixVI" class="hidden">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="viEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-vi-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="viRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="viTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="viPageSize" data-action="change-appendix-vi-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="viPrevBtn" type="button" data-action="appendix-vi-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="viPageNumbers" class="flex items-center gap-1"></div>
                <button id="viNextBtn" type="button" data-action="appendix-vi-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-vi-drawer" here, same fix already proven
         for VI-A/III. Only the header's X button and the footer's Cancel button close it. -->
    <div id="viDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action/cascade as before) -->
    <aside id="viDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Non Tax Revenue form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="viDrawerTitle" class="text-base font-bold text-ubis-navy">Add Record</h2>
                    @* <p id="viDrawerSubtitle" class="text-[11px] text-slate-500">Create a new record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixVI" id="appendixVIForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixVI-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="VI" />
            <input type="hidden" name="appendixId" value="@Model.AppendixId" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                @if (Model.IsNilSubmitted)
                {
                    <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                }
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Receipt Details</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Receipt Type <span class="text-red-500">*</span></p>
                            @* Options from dbo.M_Appendix_VI_ReceiptType (prefetched into Model.ReceiptTypes).
                               The record stores NewRecord.ReceiptTypeId; the microservice resolves the name. *@
                            <select class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" required asp-for="NewRecord.ReceiptTypeId">
                                <option value="">Select</option>
                                @foreach (var rt in Model.ReceiptTypes)
                                {
                                    <option value="@rt.Id">@rt.Name</option>
                                }
                            </select>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">PSU/Receipt Name <span class="text-red-500">*</span></p>
                            @* No character-pattern restriction (bug fix 2026-08-31 - see original
                               inline-table version's own comment): real PSU/company names routinely
                               contain periods, digits, ampersands, hyphens ("NTPC Ltd.", "ONGC
                               Videsh Ltd. 2"). *@
                            <input class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="text" maxlength="50" required asp-for="NewRecord.PsuReceiptName" />
                        </div>
                    </div>
                </section>

                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Actuals</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-3">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">@yActuals <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" required asp-for="NewRecord.Actuals" title="Auto-loaded from this Receipt Type's own history one year prior - editable" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">B.E. @yBe <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" required asp-for="NewRecord.BE" title="Auto-loaded from this Receipt Type's own history one year prior - editable" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">upto 9/@septYear <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" required asp-for="NewRecord.ActualsUptoSept" title="Auto-loaded from this Receipt Type's own history one year prior - editable" />
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">Proposed</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-3">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Proposed Collection in Q-3</p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" asp-for="NewRecord.ProposedCollectionQ3" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Proposed Collection in Q-4</p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" asp-for="NewRecord.ProposedCollectionQ4" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Proposed B.E. @yProposed <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" maxlength="15" required asp-for="NewRecord.ProposedBE" />
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="p-4">
                        <label class="mb-1.5 block text-xs font-semibold text-slate-700" asp-for="NewRecord.Remarks">Remarks</label>
                        <textarea class="w-full resize-none rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" maxlength="500" rows="4" placeholder="Enter remarks..." asp-for="NewRecord.Remarks"></textarea>
                    </div>
                </section>
            </div>

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                    <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-vi-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="viToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="viToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="viToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="viToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="viToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="viDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="viDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="viDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="viCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="viConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
