@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixIIViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix II - Quarterly Expenditure Plan";
    // "CY" (Current Year, per this appendix's own title) is the already-in-progress year - that's
    // PriorFinancialYear in this app's naming (FinancialYear is the future year being budgeted for).
    var yMinus2 = Model.PriorPriorFinancialYear;
    var yMinus1 = Model.PriorFinancialYear;
    var locked = Model.IsEntryLocked;

    // "Approved design for all appendixes" (extended 2026-09-08 to the remaining PreBudget
    // appendixes beyond VI-A..E) - same drawer/grid theme, same appendix-drawer-design.css/shared
    // drawer JS pattern reused verbatim (see ubis2_appendix_redesign_reuse_shared_files memory) -
    // only appendix-ii-drawer.js is new, and it owns just the drawer-chrome/grid-toolbar mechanics;
    // the actual field population on Edit is still handled by PreBudget-control-binding.js's
    // existing (now document-scoped) edit-appendix-ii-record dispatch and recalcAppendixIITotals -
    // untouched, reused as-is.
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="file-spreadsheet" class="h-6 w-6"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix II</h2>
                        @* <span id="iiRecordCountBadge" class="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200">@Model.Records.Count Record@(Model.Records.Count == 1 ? "" : "s")</span> *@
                    @if (Model.IsAppendixFrozen)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>Freezed
                        </span>
                    }
                    else if (Model.IsNilSubmitted)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="freezedot"></span>NIL
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold ring-1 ring-inset bg-indigo-100 text-indigo-800 ring-indigo-200">
                            <span class="bluedot"></span>In Progress
                        </span>
                    }
                    </div>
                    <p class="mt-1.5 text-sm font-medium text-slate-600"> Quarterly Expenditure Plan (on Gross Basis) </p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                @* Freeze/Nil next to Add, per designer markup - see AppendixVIA.cshtml's matching comment. *@
                @if (Model.Records.Count == 0 && !locked)
                {
                    <button type="submit" form="appendixIIForm" formnovalidate formaction="@Url.Action("SetNilSubmission")"
                            class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Nil
                    </button>
                }
                @if (Model.Records.Count > 0 && !locked)
                {
                    <button type="submit" form="appendixIIForm" formnovalidate formaction="@Url.Action("FreezeAppendixTemplate")"
                            class="inline-flex h-10 items-center justify-center rounded-lg bg-orange-100 px-4 text-sm font-semibold freeze-button shadow-sm transition hover:bg-orange-200 focus:outline-none focus:ring-4 focus:ring-orange-100">
                        Freeze Data
                    </button>
                }
                @* Client requirement 2026-08-27 (AppendixIIController.cs's own comment: "data can be
                   edited if there is entry, second entry is prohibited - same one-row-per-Demand+
                   FinancialYear rule as Appendix I-A"): Appendix II only ever permits ONE record per
                   Demand+FinancialYear - Add is hidden once that one record exists, leaving Edit
                   (via the grid row's own action menu) as the only way in. Confirmed 2026-09-08 this
                   is genuinely unique to I-A/II - every other appendix in this family keys its own
                   duplicate-check on a specific Scheme/MajorHead/Name combination instead of "any
                   record at all", so Add stays available there once a differently-keyed record can
                   still be added. *@
                @if (Model.Records.Count == 0 && !locked)
                {
                    <button type="button" data-action="open-appendix-ii-add-drawer"
                            class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-ubis-navy px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-ubis-dark focus:outline-none focus:ring-4 focus:ring-blue-100">
                        <i data-lucide="plus" class="h-4 w-4"></i>Add
                    </button>
                }
            </div>
        </div>
    </section>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mb-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    <!-- Filter & Context -->
        <!-- Data Grid -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="relative"><i data-lucide="search" class="absolute left-3 top-3 h-4 w-4 text-slate-400"></i><input id="iiSearchInput" type="search" placeholder="Search" class="search-control" /></div>
            <div class="flex items-center gap-2">
                
                <div class="relative">
                    <button id="iiColumnsButton" type="button"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="iiColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-cyan-50 px-4 py-3">
                            <p class="text-xs font-bold text-slate-800">Visible columns</p>
                            <p class="mt-0.5 text-[10px] text-slate-500">Choose the information shown in the table.</p>
                        </div>
                        <div class="space-y-1 p-2">
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="prevqep" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Approved QEP @yMinus2</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="prevact" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals @yMinus2</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="curqep" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Approved QEP @yMinus1</label>
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="curact" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals @yMinus1</label>
                        </div>
                        <div class="border-t border-slate-100 bg-slate-50 px-3 py-2.5">
                            <button type="button" data-action="reset-appendix-ii-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                <button id="iiExportButton" type="button" data-action="toggle-appendix-ii-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="iiExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="iiExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-ii" data-format="pdf"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600">
                            <i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i>
                            <span>PDF</span>
                        </button>
                        <button type="button" data-action="export-appendix-ii" data-format="excel"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600">
                            <i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i>
                            <span>Excel</span>
                        </button>
                        <button type="button" data-action="export-appendix-ii" data-format="csv"
                                class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">
                            <i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="iiGridScroll" class="grid-scroll">
            <span class="amtmsg">Amount in Crores of Rupees</span>
            <table id="chargesTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th rowspan="2" class="w-[12%] px-2 py-3 text-center">Quarter</th>
                        <th colspan="2" class="w-[20%] px-2 py-3 text-center">@yMinus2</th>
                        <th colspan="2" class="w-[20%] px-2 py-3 text-center">@yMinus1</th>
                        @if (!locked)
                        {
                            <th rowspan="2" class="w-[5%] px-2 py-3 text-center">Action</th>
                        }
                      </tr>

                    <tr class="data-grid__header-row">
                        <th data-column="prevqep" class="w-[10%] px-2 py-3 text-center"><button type="button" data-sort-key="prevqep" class="mx-auto flex items-center gap-1">As per approved QEP</button></th>
                        <th data-column="prevact" class="w-[10%] px-2 py-3 text-center"><button type="button" data-sort-key="prevact" class="mx-auto flex items-center gap-1">Actuals</button></th>
                        <th data-column="curqep" class="w-[10%] px-2 py-3 text-center"><button type="button" data-sort-key="curqep" class="mx-auto flex items-center gap-1">As per approved QEP</button></th>
                        <th data-column="curact" class="w-[10%] px-2 py-3 text-center"><button type="button" data-sort-key="curact" class="mx-auto flex items-center gap-1">Actuals</button></th>
                    </tr>
                </thead>
                <tbody id="gridBody" class="divide-y divide-slate-100">
                    @for (var i = 0; i < Model.Records.Count; i++)
                    {
                        var r = Model.Records[i];
                        var status = r.IsFrozen ? "Frozen" : "Active";
                        // Client requirement 2026-09-18: the Q1/Q2 rows must filter independently
                        // (each carries its own data-search built only from its own visible values).
                        // The Action column itself stays a single rowspan="2" cell anchored on Q1
                        // (one record = one menu) per a later 2026-09-18 client correction - same
                        // as Appendix I-A's revert.
                        // Bug fix 2026-09-18: the haystack was missing the visible "1st Quarter"/"2nd
                        // Quarter" label text each row actually displays - searching for that literal
                        // text (e.g. "2nd") matched nothing at all, same class of bug already fixed
                        // for Appendix I-A's "(Proposed by Ministry)" label.
                        var q1Haystack = string.Join(" ", new[]
                        {
                            r.Id.ToString(), "1st Quarter", r.RemarksQ1, status,
                            r.Q1ApprovedQepPrevYear?.ToString("0.00") ?? "0.00",
                            r.Q1ActualsPrevYear?.ToString("0.00") ?? "0.00",
                            r.Q1ApprovedQep?.ToString("0.00") ?? "0.00",
                            r.Q1Actuals?.ToString("0.00") ?? "0.00"
                        });
                        var q2Haystack = string.Join(" ", new[]
                        {
                            r.Id.ToString(), "2nd Quarter", r.RemarksQ2, status,
                            r.Q2ApprovedQepPrevYear?.ToString("0.00") ?? "0.00",
                            r.Q2ActualsPrevYear?.ToString("0.00") ?? "0.00",
                            r.Q2ApprovedQep?.ToString("0.00") ?? "0.00",
                            r.Q2Actuals?.ToString("0.00") ?? "0.00"
                        });
                        <tr data-row data-status="@status" data-search="@q1Haystack"
                            data-sort-prevqep="@r.Q1ApprovedQepPrevYear" data-sort-prevact="@r.Q1ActualsPrevYear"
                            data-sort-curqep="@r.Q1ApprovedQep" data-sort-curact="@r.Q1Actuals"
                            class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                            <td class="relative px-2 py-3 text-center text-xs font-semibold text-slate-600">1<span class="align-super text-xs">st</span> Quarter</td>
                            <td data-column="prevqep" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q1ApprovedQepPrevYear?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="prevact" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q1ActualsPrevYear?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="curqep" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q1ApprovedQep?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="curact" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q1Actuals?.ToString("0.00") ?? "0.00")</td>
                            @if (!locked)
                            {
                                <td class="grid-action-cell px-2 py-3 text-center" rowspan="2">
                                    @if (!r.IsFrozen)
                                    {
                                        <div class="relative inline-block">
                                            <button type="button" class="row-menu-btn inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                                                    data-action-id="@r.Id" aria-label="Actions for record @(i + 1)" aria-haspopup="true">
                                                <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                            </button>
                                            <div id="ii-menu-@r.Id" class="action-menu absolute right-0 top-9 z-20 hidden w-40 rounded-xl border border-slate-200 bg-white p-1.5 text-left shadow-xl">
                                                <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700"
                                                        data-action="edit-appendix-ii-record"
                                                        data-id="@r.Id"
                                                        data-q1-approved-qep-prev-year="@r.Q1ApprovedQepPrevYear"
                                                        data-q1-actuals-prev-year="@r.Q1ActualsPrevYear"
                                                        data-q1-approved-qep="@r.Q1ApprovedQep"
                                                        data-q1-actuals="@r.Q1Actuals"
                                                        data-remarks-q1="@r.RemarksQ1"
                                                        data-q1-has-deviation="@r.Q1HasDeviation.ToString().ToLowerInvariant()"
                                                        data-q1-mof-approval-details="@r.Q1MofApprovalDetails"
                                                        data-q2-approved-qep-prev-year="@r.Q2ApprovedQepPrevYear"
                                                        data-q2-actuals-prev-year="@r.Q2ActualsPrevYear"
                                                        data-q2-approved-qep="@r.Q2ApprovedQep"
                                                        data-q2-actuals="@r.Q2Actuals"
                                                        data-remarks-q2="@r.RemarksQ2"
                                                        data-q2-has-deviation="@r.Q2HasDeviation.ToString().ToLowerInvariant()"
                                                        data-q2-mof-approval-details="@r.Q2MofApprovalDetails">
                                                    <i data-lucide="pencil" class="h-3.5 w-3.5"></i>Edit
                                                </button>
                                                <button type="button" data-action="delete-appendix-ii-trigger" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-red-600 hover:bg-red-50">
                                                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>Delete
                                                </button>
                                                <form method="post" asp-action="DeleteAppendixII" class="hidden">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="demandId" value="@Model.DemandId" />
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-semibold text-slate-500">Frozen</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr data-row data-status="@status" data-search="@q2Haystack"
                            data-sort-prevqep="@r.Q2ApprovedQepPrevYear" data-sort-prevact="@r.Q2ActualsPrevYear"
                            data-sort-curqep="@r.Q2ApprovedQep" data-sort-curact="@r.Q2Actuals"
                            class="group border-b border-slate-100 transition odd:bg-white even:bg-slate-50/60 hover:bg-cyan-50/60 @(r.IsFrozen ? "bg-slate-50" : "")">
                            <td class="relative px-2 py-3 text-center text-xs font-semibold text-slate-600">2<span class="align-super text-xs">nd</span> Quarter</td>
                            <td data-column="prevqep" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q2ApprovedQepPrevYear?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="prevact" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q2ActualsPrevYear?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="curqep" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q2ApprovedQep?.ToString("0.00") ?? "0.00")</td>
                            <td data-column="curact" class="grid-cell grid-cell--compact grid-cell--center grid-cell--strong NumericData">@(r.Q2Actuals?.ToString("0.00") ?? "0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div> 



        

        <div id="iiEmptyState" class="@(Model.Records.Count == 0 ? "" : "hidden") px-6 py-14 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="search-x" class="h-5 w-5"></i>
            </div>
            <h4 class="mt-3 text-sm font-bold text-slate-700">No records found</h4>
            <p class="mt-1 text-xs text-slate-500">@(Model.Records.Count == 0 ? "No records to display yet." : "Try changing your filters or search criteria.")</p>
            @if (Model.Records.Count > 0)
            {
                <button type="button" data-action="clear-appendix-ii-filters" class="mt-4 rounded-lg bg-ubis-navy px-4 py-2 text-xs font-semibold text-white">Clear Filters</button>
            }
        </div>

        <div class="flex flex-col justify-between gap-3 border-t border-slate-100 px-5 py-3 sm:flex-row sm:items-center">
            <div class="text-[11px] text-slate-500">
                Showing <span id="iiRangeText" class="font-semibold text-slate-700">@(Model.Records.Count == 0 ? "0" : "1–" + Model.Records.Count)</span> of <span id="iiTotalText" class="font-semibold text-slate-700">@Model.Records.Count</span> records
            </div>
            <div class="flex items-center gap-2">
                <label class="hidden items-center gap-2 text-[11px] text-slate-500 sm:flex">
                    Rows:
                    <select id="iiPageSize" data-action="change-appendix-ii-page-size" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <button id="iiPrevBtn" type="button" data-action="appendix-ii-prev-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i> Previous
                </button>
                <div id="iiPageNumbers" class="flex items-center gap-1"></div>
                <button id="iiNextBtn" type="button" data-action="appendix-ii-next-page" class="flex h-8 items-center gap-1 rounded-lg border border-slate-200 px-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Next <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Drawer backdrop - no data-action="close-appendix-ii-drawer" here, same fix already
         proven for VI-A. Only the header's X button and the footer's Cancel button close it. -->
    <div id="iiDrawerBackdrop" class="ubis-backdrop-hide fixed inset-0 z-[60] bg-slate-950/45 backdrop-blur-[2px] transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Right drawer - the REAL Add/Edit form (same asp-for bindings/POST action as before) -->
    <aside id="iiDrawer" class="ubis-drawer-closed fixed right-0 top-0 z-[70] flex h-screen w-full max-w-[820px] flex-col border-l border-indigo-100 bg-white shadow-drawer transition-transform duration-300 ease-out" aria-label="Quarterly Expenditure Plan form" aria-hidden="true">
        <div class="flex shrink-0 items-center justify-between border-b border-indigo-100 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ubis-tealLight text-ubis-teal">
                    <i data-lucide="file-spreadsheet" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="iiDrawerTitle" class="text-base font-bold text-ubis-navy">Add Quarterly Expenditure Plan</h2>
                    @* <p id="iiDrawerSubtitle" class="text-[11px] text-slate-500">Create a new QEP record</p> *@
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-800">Demand No. @Model.DemandNo</span>
                        <span class="text-[10px] font-semibold italic text-red-600">Amount in Crores of Rupees</span>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" autocomplete="off" asp-action="SaveAppendixII" id="appendixIIForm" data-demand-id="@Model.DemandId" data-autosave-key="PreBudget-AppendixII-@Model.DemandId" class="flex min-h-0 flex-1 flex-col">
            @Html.AntiForgeryToken()
            <input type="hidden" name="demandId" value="@Model.DemandId" />
            <input type="hidden" name="code" value="II" />
            <input type="hidden" name="appendixId" value="@Model.AppendixId" />
            <input type="hidden" asp-for="NewRecord.Id" />
            <fieldset disabled="@locked" style="border:none;margin:0;padding:0;display:contents;">
            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50/70 px-5 py-5">
                @if (Model.IsNilSubmitted)
                {
                    <p class="mb-4 rounded-lg border border-teal-100 bg-ubis-tealLight px-3 py-2.5 text-sm text-slate-700">You have marked Nil Data for this Template, so data cannot be entered</p>
                }
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">1st Quarter</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">As per Approved QEP @yMinus2</p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-slate-100 pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none cursor-not-allowed" type="number" step="0.01" min="0" readonly asp-for="NewRecord.Q1ApprovedQepPrevYear" title="From approved QEP, financial year @yMinus2 - not editable here." />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold  tracking-wide text-slate-500">Actuals @yMinus2 <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q1ActualsPrevYear" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold  tracking-wide text-slate-500">As per Approved QEP @yMinus1 BE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q1ApprovedQep" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold  tracking-wide text-slate-500">Actuals @yMinus1 <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q1Actuals" />
                            </div>
                        </div>
                    </div>

                    <div class="grid pt-2 pl-3 md:grid-cols-1">
                        <h3 class="text-sm font-bold text-slate-800">2nd Quarter</h3>
                    </div>
                    <div class="grid gap-3 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">As per Approved QEP @yMinus2</p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-slate-100 pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none cursor-not-allowed" type="number" step="0.01" min="0" readonly asp-for="NewRecord.Q2ApprovedQepPrevYear" title="From approved QEP, financial year @yMinus2 - not editable here." />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold  tracking-wide text-slate-500">Actuals @yMinus2 <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q2ActualsPrevYear" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-[10px] font-bold tracking-wide text-slate-500">As per Approved QEP @yMinus1 BE <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q2ApprovedQep" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-[10px] font-bold tracking-wide text-slate-500">Actuals @yMinus1 <span class="text-red-500">*</span></p>
                            <div class="relative mt-2">
                                <span class="absolute left-3 top-2.5 text-xs font-semibold text-slate-400">₹</span>
                                <input class="NumericData tabular h-10 w-full rounded-lg border border-slate-300 bg-white pl-7 pr-3 text-right text-sm font-semibold text-slate-800 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="number" step="0.01" min="0" required asp-for="NewRecord.Q2Actuals" />
                            </div>
                        </div>
                    </div>

                </section>

                @* FRS Deviation Information (§4.2.3/§8.4/§11.3) - client instruction 2026-09-10:
                   MoF Approval Details stays dropped, but Remarks is back (mandatory per FRS
                   whenever that quarter's deviation checkbox is checked) - shown/hidden and
                   required/not-required per quarter via appendix-ii-drawer.js's
                   applyAppendixIIDeviationUI, keyed off each quarter's own checkbox. *@
                <section class="mb-4 rounded-xl border border-slate-200 bg-white">
                    <div class="grid pt-4 pl-3 md:grid-cols-1">
                            <h3 class="text-sm font-bold text-slate-800">
                                Whether any deviation from MEP/QEP in FY @yMinus1 BE
                                (If, yes, whether approval of MoF obtained ?)
                        </h3>
                    </div>
                    <div class="grid gap-4 p-4 md:grid-cols-2">
                        <div class="rounded-xl border border-slate-200 p-3">
                            <label class="flex items-center gap-2 text-xs font-semibold text-slate-700">
                                <input type="checkbox" asp-for="NewRecord.Q1HasDeviation" class="h-4 w-4 rounded border-slate-300 text-ubis-teal focus:ring-teal-200" />
                                1st Quarter - Deviation from MEP/QEP?
                            </label>
                            <div data-deviation-remarks="q1" class="mt-2 hidden">
                                <label class="mb-1.5 block text-[10px] font-semibold text-slate-500">Remarks (mandatory if deviation)</label>
                                <input class="RemarksText h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="text" maxlength="500" asp-for="NewRecord.RemarksQ1" />
                            </div>
                        </div>
                        <div class="rounded-xl border border-slate-200 p-3">
                            <label class="flex items-center gap-2 text-xs font-semibold text-slate-700">
                                <input type="checkbox" asp-for="NewRecord.Q2HasDeviation" class="h-4 w-4 rounded border-slate-300 text-ubis-teal focus:ring-teal-200" />
                                2nd Quarter - Deviation from MEP/QEP?
                            </label>
                            <div data-deviation-remarks="q2" class="mt-2 hidden">
                                <label class="mb-1.5 block text-[10px] font-semibold text-slate-500">Remarks (mandatory if deviation)</label>
                                <input class="RemarksText h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-700 outline-none focus:border-ubis-teal focus:ring-4 focus:ring-teal-50" type="text" maxlength="500" asp-for="NewRecord.RemarksQ2" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            

            <div class="flex shrink-0 items-center justify-end border-t border-slate-200 bg-white px-5 py-3.5">
                <div class="flex items-center gap-2">
                        <button type="reset" class="h-9 rounded-lg border border-ubis-navy px-3.5 text-xs font-semibold text-ubis-navy hover:bg-blue-50">Clear</button>
                    <button type="button" data-action="close-appendix-ii-drawer" class="h-9 rounded-lg border border-slate-300 px-3.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>                   
                    <button type="submit" class="h-9 rounded-lg bg-ubis-teal px-4 text-xs font-bold text-white shadow-sm hover:bg-teal-700">Save Record</button>
                </div>
            </div>
            </fieldset>
        </form>
    </aside>

    <!-- Toast -->
    <div id="iiToast" class="ubis-toast-hide ubis-toast-success fixed bottom-5 right-5 z-[100] flex w-[calc(100%-2rem)] max-w-sm items-start gap-3 rounded-xl border bg-white p-4 shadow-2xl transition-all duration-300" aria-live="polite" aria-atomic="true">
        <div class="ubis-toast-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
            <i id="iiToastIcon" data-lucide="check-circle-2" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0 flex-1">
            <p id="iiToastTitle" class="text-xs font-bold text-slate-800">Success</p>
            <p id="iiToastMessage" class="mt-0.5 text-[11px] text-slate-500"></p>
        </div>
        <button id="iiToastClose" type="button" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-100" aria-label="Close notification"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>

    <!-- Delete confirmation dialog -->
    <div id="iiDeleteDialog" class="ubis-dialog-hide fixed inset-0 z-[110] flex items-center justify-center bg-slate-950/45 p-4 backdrop-blur-[2px] transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="iiDeleteDialogTitle" aria-hidden="true">
        <div class="ubis-dialog-card w-full max-w-md rounded-2xl border border-red-100 bg-white p-5 shadow-2xl transition-all duration-200">
            <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                    <i data-lucide="trash-2" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 id="iiDeleteDialogTitle" class="text-base font-bold text-slate-900">Delete</h2>
                    <p class="mt-1 text-sm leading-5 text-slate-500">Are you sure you want to delete?</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button id="iiCancelDeleteBtn" type="button" class="h-10 rounded-lg border border-slate-300 px-4 text-xs font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100">Cancel</button>
                <button id="iiConfirmDeleteBtn" type="button" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"><i data-lucide="trash-2" class="h-4 w-4"></i>Delete record</button>
            </div>
        </div>
    </div>
</div>
