@model UBIS.Web.Areas.PreBudgetMeeting.Models.AppendixVSummaryViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Appendix V : Estimates of Establishment & Other Central Expenditure";
    var yMinus2 = Model.PriorPriorFinancialYear;
    var yMinus1 = Model.PriorFinancialYear;
    var y = Model.FinancialYear;
    var lastTotalIndex = Model.Rows.FindLastIndex(r => r.IsTotal);

    // Visual refresh 2026-09-14 (designer reference: UBIS-drawer-070926 "Appendix-V.html") - matches
    // the drawer/grid theme's header/typography now used by V-A/V-B/V-C, but stays exactly what it
    // was functionally: a read-only report auto-computed from Appendix V-A + V-B + V-C's own saved
    // data (Model.Rows), no Add/Edit drawer, no entity of its own, no new controller actions. The
    // mockup's editable grid/Add-drawer/per-row "Budget Div." columns are NOT part of this page -
    // per the client's own confirmation, this remains a pure rollup.
}

<div class="ubis-modern-appendix">
    <section class="appendix-highlight mb-5 rounded-2xl border p-4">
        <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
            <div class="flex items-start gap-3">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="layout-grid" class="h-6 w-6"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-extrabold tracking-tight text-indigo-950">Appendix V</h2>
                    <p class="mt-1.5 text-sm font-medium text-slate-600">Estimates of Establishment &amp; Other Central Expenditure</p>
                </div>
            </div>
            <p class="text-xs font-bold uppercase tracking-wide text-red-600">Amount in Crores of Rupees</p>
        </div>
    </section>

    <div class="mb-4 rounded-xl border border-teal-100 bg-ubis-tealLight px-4 py-3">
        <p class="text-sm font-semibold text-slate-700">The data reflected below is automatically populated from Appendix V-A, Appendix V-B and Appendix V-C respectively.</p>
    </div>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col justify-end gap-3 border-b border-slate-100 px-5 py-3.5 sm:flex-row sm:items-center" data-demand-id="@Model.DemandId">
            <div class="flex items-center gap-2">
                <div class="relative">
                    <button id="vColumnsButton" type="button" data-action="toggle-appendix-v-columns-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vColumnsMenu">
                        <i data-lucide="columns-3" class="h-3.5 w-3.5"></i> Columns
                    </button>
                    <div id="vColumnsMenu" class="absolute right-0 top-10 z-30 hidden w-56 overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-2xl" role="menu" aria-label="Choose visible columns">
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="item" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Item</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="actual" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actual @yMinus2</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="actualsuptoseptprevyear" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals upto 9/@(yMinus2.Split('-')[0])</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="be" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">B.E. @yMinus1</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="actualsuptosept" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">Actuals upto 9/@(yMinus1.Split('-')[0])</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="percentwrtbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">% w.r.t B.E. @yMinus1</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="proposedre" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">R.E. @yMinus1 (Proposed by Min/Dep)</label>
                        <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"><input type="checkbox" data-column-toggle="proposednbe" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-200">B.E. @y (Proposed by Min/Dep)</label>
                        <div class="mt-1 border-t border-slate-100 pt-1"><button type="button" data-action="reset-appendix-v-columns" class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-50"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>Reset columns</button></div>
                    </div>
                </div>
                <div class="relative">
                    <button id="vExportButton" type="button" data-action="toggle-appendix-v-export-menu"
                            class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100"
                            aria-haspopup="true" aria-expanded="false" aria-controls="vExportMenu">
                        <i data-lucide="download" class="h-3.5 w-3.5"></i> Export
                        <i data-lucide="chevron-down" class="h-3 w-3 text-slate-400"></i>
                    </button>
                    <div id="vExportMenu" class="absolute right-0 top-10 z-30 hidden w-44 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-2xl">
                        <button type="button" data-action="export-appendix-v" data-format="pdf" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-rose-600"><i data-lucide="file-text" class="h-4 w-4 text-rose-500"></i><span>PDF</span></button>
                        <button type="button" data-action="export-appendix-v" data-format="excel" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600"><i data-lucide="sheet" class="h-4 w-4 text-emerald-600"></i><span>Excel</span></button>
                        <button type="button" data-action="export-appendix-v" data-format="csv" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600"><i data-lucide="file-spreadsheet" class="h-4 w-4 text-blue-500"></i><span>CSV</span></button>
                    </div>
                </div>
            </div>
        </div>
        <div id="vGridScroll" class="grid-scroll">
            <table id="vSummaryTable" class="ubis-data-grid">
                <thead class="ubis-data-grid__head ubis-data-grid__head--plain">
                    <tr class="data-grid__header-row">
                        <th data-column="item" class="w-[20%] px-2 py-3">Item</th>
                        <th data-column="actual" class="w-[10%] px-2 py-3 text-right">Actual @yMinus2</th>
                        <th data-column="actualsuptoseptprevyear" class="w-[10%] px-2 py-3 text-right">Actuals upto 9/@(yMinus2.Split('-')[0])</th>
                        <th data-column="be" class="w-[10%] px-2 py-3 text-right">B.E. @yMinus1</th>
                        <th data-column="actualsuptosept" class="w-[10%] px-2 py-3 text-right">Actuals upto 9/@(yMinus1.Split('-')[0])</th>
                        <th data-column="percentwrtbe" class="w-[10%] px-2 py-3 text-right">% w.r.t. B.E. @yMinus1</th>
                        <th data-column="proposedre" class="w-[15%] px-2 py-3 text-right">R.E. @yMinus1 (Proposed by Min/Dep)</th>
                        <th data-column="proposednbe" class="w-[15%] px-2 py-3 text-right">B.E. @y (Proposed by Min/Dep)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="8" class="empty-state-cell">No records to display.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            if (row.IsSectionHeader)
                            {
                                <tr class="border-y border-slate-300 bg-slate-100/90">
                                    <td colspan="8" class="px-2 py-2.5 text-xs font-bold text-slate-800">@row.Label</td>
                                </tr>
                            }
                            else if (row.IsTotal)
                            {
                                var isGrandTotal = i == lastTotalIndex;
                                <tr class="@(isGrandTotal ? "border-b-2 border-slate-300 bg-slate-100 font-bold" : "bg-slate-50/80 font-semibold")">
                                    <td data-column="item" class="px-2 py-2.5 text-xs text-slate-800">@row.Label</td>
                                    <td data-column="actual" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.Actual?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="actualsuptoseptprevyear" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.ActualsUptoSeptPrevYear?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="be" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.BE?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="actualsuptosept" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.ActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="percentwrtbe" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.PercentWrtBE?.ToString("0.00") ?? "-")</td>
                                    <td data-column="proposedre" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.ProposedRE?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="proposednbe" class="tabular px-2 py-2.5 text-right text-xs text-slate-800">@(row.ProposedNBE?.ToString("0.00") ?? "0.00")</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="odd:bg-white even:bg-slate-50/60">
                                    <td data-column="item" class="break-words px-2 py-2.5 text-xs text-slate-700">@row.Label</td>
                                    <td data-column="actual" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.Actual?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="actualsuptoseptprevyear" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.ActualsUptoSeptPrevYear?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="be" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.BE?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="actualsuptosept" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.ActualsUptoSept?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="percentwrtbe" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.PercentWrtBE?.ToString("0.00") ?? "-")</td>
                                    <td data-column="proposedre" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.ProposedRE?.ToString("0.00") ?? "0.00")</td>
                                    <td data-column="proposednbe" class="tabular px-2 py-2.5 text-right text-xs text-slate-700">@(row.ProposedNBE?.ToString("0.00") ?? "0.00")</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
