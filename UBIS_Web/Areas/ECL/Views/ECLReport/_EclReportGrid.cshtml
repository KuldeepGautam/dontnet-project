@model UBIS.Web.Areas.ECL.Models.EclReportViewModel
@{
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
}

<section class="panel overflow-hidden p-0 animate-fade-in">
    <div class="heading text-center heading-bg justify-between items-center border rounded px-4 py-3 text-white">
        @Model.Title
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="px-5 pt-4">
            <p class="text-sm font-semibold @(Model.StatusIsError ? "text-red-600" : "text-teal")" role="status">@Model.StatusMessage</p>
        </div>
    }

    @if (Model.UsesGeneralListEndpoint)
    {
        <div class="px-5 pt-3">
            <p class="text-[11px] text-slate-400 italic">Served off the ECL API's general outlay list endpoint (Part 1 built no dedicated reporting endpoint for this screen).</p>
        </div>
    }

    <div class="flex flex-col gap-5 p-5">
        <form method="get" asp-action="@actionName" class="grid w-full grid-cols-1 gap-4 lg:grid-cols-3">
            <label class="table-toolbar-field">
                <span class="font-bold text-xs uppercase tracking-wider text-slate-600">Financial Year</span>
                <select name="financialYear" class="input truncate">
                    @foreach (var y in Model.FinancialYearOptions)
                    {
                        <option value="@y" selected="@(y == Model.FinancialYear)">@y</option>
                    }
                </select>
            </label>
            <label class="table-toolbar-field">
                <span class="font-bold text-xs uppercase tracking-wider text-slate-600">Demand Name</span>
                <select name="demandId" class="input truncate">
                    <option value="">All</option>
                    @foreach (var d in Model.Demands)
                    {
                        <option value="@d.DemandId" selected="@(d.DemandId == Model.SelectedDemandId)">@d.DemandNo-@d.DemandName</option>
                    }
                </select>
            </label>
            @if (Model.ShowCategoryFilter)
            {
                <label class="table-toolbar-field">
                    <span class="font-bold text-xs uppercase tracking-wider text-slate-600">Category</span>
                    <select name="categoryId" class="input truncate">
                        <option value="">All</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.CategoryId" selected="@(c.CategoryId == Model.SelectedCategoryId)">@c.SerialNo - @c.CategoryName</option>
                        }
                    </select>
                </label>
            }
            <div class="flex items-end lg:col-start-3 lg:justify-self-end">
                <button type="submit" class="btn-primary text-xs py-2 px-4">Generate Report</button>
            </div>
        </form>

        <div class="flex flex-col gap-1 items-end sm:flex-row sm:items-center sm:justify-between">
            <div class="flex gap-2">
                <a data-export-link href="@Url.Action(actionName + "ExportPdf", new { demandId = Model.SelectedDemandId, financialYear = Model.FinancialYear })" class="btn-secondary text-xs py-1 px-3">Export to PDF</a>
                <a data-export-link href="@Url.Action(actionName + "ExportExcel", new { demandId = Model.SelectedDemandId, financialYear = Model.FinancialYear })" class="btn-secondary text-xs py-1 px-3">Export to Excel</a>
            </div>
            <div class="text-right text-red-600 font-medium text-xs md:text-sm italic">Amount in Crores of Rupees</div>
        </div>

        <div class="overflow-x-auto rounded-lg border border-slate-200 shadow-sm">
            <table id="eclReportGrid" class="demo-table w-full text-xs">
                <colgroup>
                    <col style="width:5%" />
                    <col style="width:10%" />
                    <col style="width:25%" />
                    <col style="width:25%" />
                    <col style="width:12%" />
                    <col style="width:12%" />
                    <col style="width:11%" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Financial Year</th>
                        <th>Demand</th>
                        <th>Scheme</th>
                        <th>Total Outlay</th>
                        <th>Central Share</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-state-cell">No data for the selected filters.</td></tr>
                    }
                    else
                    {
                        var sr = 1;
                        @foreach (var row in Model.Rows)
                        {
                            var demandLabel = !string.IsNullOrEmpty(row.DemandName) ? $"{row.DemandNo} - {row.DemandName}" : $"Demand #{row.DemandId}";
                            var schemeLabel = !string.IsNullOrEmpty(row.SchemeName) ? $"{row.SchemeSrNo ?? 0} - {row.SchemeName}" : $"Scheme #{row.SchemeId}";
                            <tr>
                                <td>@(sr++)</td>
                                <td>@row.FinancialYear</td>
                                <td class="text-left">@demandLabel</td>
                                <td class="text-left">@schemeLabel</td>
                                <td class="text-right">@row.TotalOutlay?.ToString("N2")</td>
                                <td class="text-right">@row.CentralShare?.ToString("N2")</td>
                                <td>@row.DoeApprovalStatusDisplay</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
