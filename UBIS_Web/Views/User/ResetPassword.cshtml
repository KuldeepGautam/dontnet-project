@model ResetPasswordViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#063f66">
    <title>Reset Password | Union Budget Information System</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
    <script src="~/vendor/lucide.min.js" defer></script>
</head>
<body class="login-body">
    <main class="login-page">
        <aside class="visual-panel" aria-label="Indian Parliament building"></aside>
        <section class="form-panel" aria-label="Set a new password">
            <div class="login-card">
                <header class="identity">
                    <div class="seal"><img src="~/images/emblem-dark.png" alt="Emblem of India"></div>
                    <div>
                        <p lang="hi">भारत सरकार</p>
                        <h1>Government of India</h1>
                    </div>
                </header>
                <section class="department" aria-label="Union Budget Information System">
                    <img src="~/images/UBIS-Logo-LoginN.png" alt="Union Budget Information System">
                    <div class="department-copy"><strong>Department of Economic Affairs</strong>Ministry of Finance, Government of India</div>
                </section>

                @if (Model.TokenValid)
                {
                    <form asp-controller="User" asp-action="ResetPassword" method="post" class="login-form" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ResetToken" />

                        <p class="error" role="alert">@Model.ErrorMessage</p>
                        <div asp-validation-summary="ModelOnly" class="error"></div>

                        <div class="field">
                            <label asp-for="NewPassword">New Password <span class="required">*</span></label>
                            <div class="input-wrap"><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required></div>
                            <span asp-validation-for="NewPassword" class="error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="ConfirmNewPassword">Confirm New Password <span class="required">*</span></label>
                            <div class="input-wrap"><input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" minlength="12" required></div>
                            <span asp-validation-for="ConfirmNewPassword" class="error"></span>
                        </div>

                        <button class="login-submit" type="submit" style="margin-top:20px;">Reset Password</button>
                    </form>
                }
                else
                {
                    <p class="error" role="alert" style="margin-top:22px;">@Model.ErrorMessage</p>
                    <a class="forgot" asp-area="" asp-controller="User" asp-action="ForgotPassword">Request a new reset link</a>
                }

                <a class="forgot" asp-area="" asp-controller="User" asp-action="Login">Back to Login</a>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
