@model ForgotPasswordViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#063f66">
    <title>Forgot Password | Union Budget Information System</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
    <script src="~/vendor/lucide.min.js" defer></script>
</head>
<body class="login-body">
    <main class="login-page">
        <aside class="visual-panel" aria-label="Indian Parliament building"></aside>
        <section class="form-panel" aria-label="Reset your password">
            <div class="login-card">
                <header class="identity">
                    <div class="seal"><img src="~/images/emblem-dark.png" alt="Emblem of India"></div>
                    <div>
                        <p lang="hi">भारत सरकार</p>
                        <h1>Government of India</h1>
                    </div>
                </header>
                <section class="department" aria-label="Union Budget Information System">
                    <img src="~/images/UBIS-Logo-LoginN.png" alt="Union Budget Information System">
                    <div class="department-copy"><strong>Department of Economic Affairs</strong>Ministry of Finance, Government of India</div>
                </section>

                <form asp-controller="User" asp-action="ForgotPassword" method="post" class="login-form" novalidate>
                    @Html.AntiForgeryToken()

                    <p class="error" role="alert">@Model.ErrorMessage</p>
                    <p class="info" role="status">@Model.InfoMessage</p>
                    <div asp-validation-summary="ModelOnly" class="error"></div>

                    <div class="field">
                        <label asp-for="Email">Registered Email Address <span class="required">*</span></label>
                        <div class="input-wrap"><input asp-for="Email" type="email" autocomplete="email" required></div>
                        <span asp-validation-for="Email" class="error"></span>
                    </div>

                    <p style="margin-top:14px;font-size:.82rem;color:var(--ubis-muted);">
                        Note: automated password-reset emails are not yet enabled in this environment.
                        Submitting this form records the request, but until email delivery is configured,
                        please contact your system administrator to complete a password reset.
                    </p>

                    <button class="login-submit" type="submit" style="margin-top:20px;">Send Reset Instructions</button>
                </form>

                <a class="forgot" asp-area="" asp-controller="User" asp-action="Login">Back to Login</a>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
