@model ProfileViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Password Reset Required";
}

<div class="mx-auto max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-soft">
    <div class="rounded-xl border-l-4 border-ambergov bg-amber-50/90 p-4 text-sm mb-6">
        <strong>Action required:</strong> your account is still using a system-assigned default
        password. You must set a new password before you can access any other part of the system.
    </div>

    <h1 class="text-xl font-black text-navy">Set Your New Password</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
            @Model.StatusMessage
        </div>
    }

    <form asp-controller="User" asp-action="ForcePasswordReset" method="post" class="mt-5 space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm font-semibold text-red-700"></div>

        <label class="float-field">
            <input asp-for="CurrentPassword" type="password" placeholder=" " autocomplete="current-password" />
            <span>Current (Default) Password</span>
        </label>
        <span asp-validation-for="CurrentPassword" class="text-xs text-red-600"></span>

        <label class="float-field">
            <input asp-for="NewPassword" type="password" placeholder=" " autocomplete="new-password" />
            <span>New Password</span>
        </label>
        <span asp-validation-for="NewPassword" class="text-xs text-red-600"></span>

        <label class="float-field">
            <input asp-for="ConfirmNewPassword" type="password" placeholder=" " autocomplete="new-password" />
            <span>Confirm New Password</span>
        </label>
        <span asp-validation-for="ConfirmNewPassword" class="text-xs text-red-600"></span>

        <button class="w-full rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg" type="submit">
            Set Password &amp; Continue
        </button>
    </form>

    <form asp-controller="User" asp-action="Logout" method="post" class="mt-3 text-center">
        @Html.AntiForgeryToken()
        <button type="submit" class="text-xs font-bold text-slate-500 underline">Cancel and log out instead</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
