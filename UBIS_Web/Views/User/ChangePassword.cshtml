@model ProfileViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="mx-auto max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
    <h1 class="text-xl font-black text-navy dark:text-white">Change Password</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
            @Model.StatusMessage
        </div>
    }

    <form asp-controller="User" asp-action="ChangePassword" method="post" class="mt-5 space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm font-semibold text-red-700"></div>

        <label class="float-field">
            <input asp-for="CurrentPassword" type="password" placeholder=" " autocomplete="current-password" />
            <span>Current Password</span>
        </label>
        <span asp-validation-for="CurrentPassword" class="text-xs text-red-600"></span>

        <label class="float-field">
            <input asp-for="NewPassword" type="password" placeholder=" " autocomplete="new-password" />
            <span>New Password</span>
        </label>
        <span asp-validation-for="NewPassword" class="text-xs text-red-600"></span>

        <label class="float-field">
            <input asp-for="ConfirmNewPassword" type="password" placeholder=" " autocomplete="new-password" />
            <span>Confirm New Password</span>
        </label>
        <span asp-validation-for="ConfirmNewPassword" class="text-xs text-red-600"></span>

        <button class="w-full rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg" type="submit">
            Change Password
        </button>
    </form>

    <a asp-controller="User" asp-action="Dashboard" class="mt-3 block text-center text-xs font-bold text-slate-500 underline">
        Cancel
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
