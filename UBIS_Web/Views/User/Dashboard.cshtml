@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6 animate-fade-in">
    <div class="rounded-2xl bg-gradient-to-r from-navy to-teal p-6 text-white shadow-soft sm:p-8">
        <h1 class="text-2xl font-black sm:text-3xl">Welcome, @Model.FullName</h1>
        <p class="mt-2 text-sm font-semibold text-white/80">
            Signed in as <strong>@Model.UserName</strong> &middot; Role: <strong id="dashboardRoleName">@(string.IsNullOrEmpty(Model.RoleName) ? "Loading…" : Model.RoleName)</strong> &middot; FY @Model.FinancialYear
        </p>
    </div>

    <div id="bootstrapStatus" class="flex flex-col gap-1 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-semibold text-slate-500 shadow-soft dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400" role="status" aria-live="polite">
        <p id="bootstrapStatusRole" data-pending="Getting User Role…" data-done="User Role loaded.">Getting User Role&hellip;</p>
        <p id="bootstrapStatusMenu" data-pending="Loading Menu…" data-done="Menu loaded.">Loading Menu&hellip;</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-black text-navy dark:text-white">Getting started</h2>
        <p class="mt-2 text-sm text-slate-500">Use the left-hand menu to navigate to your assigned modules and functions.</p>
    </div>
</div>

@if (Model.ShowComplianceWarning)
{
    <div id="compliance-warning-modal" class="fixed inset-0 z-[9998] flex items-center justify-center bg-slate-950/40 p-4">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl dark:bg-slate-900">
            <h2 class="text-lg font-black text-navy dark:text-white">Verification Reminder</h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-300">
                @if (Model.PasswordIsStale)
                {
                    <li>Your password hasn't been changed in over a year. Please update it soon.</li>
                }
                @if (Model.EmailIsStale)
                {
                    <li>Your email address hasn't been re-validated in over 180 days. Please confirm it's still correct.</li>
                }
            </ul>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" id="compliance-warning-dismiss" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 dark:border-slate-700 dark:text-slate-300">
                    Remind me later
                </button>
                <a asp-controller="UserProfile" asp-action="Index" class="rounded-lg bg-navy px-4 py-2 text-sm font-bold text-white">
                    Go to Profile
                </a>
            </div>
        </div>
    </div>
}

<div id="dashboardStatus" class="ubis-loading-overlay is-visible" role="status" aria-live="polite">
    <div class="ubis-loading-spinner" aria-hidden="true"></div>
    <p class="ubis-loading-text">Loading your dashboard&hellip;</p>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
