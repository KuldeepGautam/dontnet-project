@model SessionSettingsViewModel
@{
    ViewData["Title"] = "Session Settings";
}

<div class="mx-auto max-w-lg space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between">
            <h1 class="text-xl font-black text-navy dark:text-white">Session Timeout Settings</h1>
            <a asp-controller="Admin" asp-action="PendingRequests" class="text-xs font-bold text-navy underline">Pending Requests</a>
        </div>
        <p class="mt-1 text-xs text-slate-500">Added 2026-07. Takes effect immediately for pages loaded after saving — no restart needed.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
                @Model.StatusMessage
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="mt-2 text-sm font-semibold text-red-700"></div>

        <form asp-controller="Admin" asp-action="SessionSettings" method="post" class="mt-5 space-y-4">
            @Html.AntiForgeryToken()
            <label class="float-field">
                <input asp-for="CurrentCountdownMinutes" type="number" min="1" max="120" placeholder=" " />
                <span>Session Countdown (minutes)</span>
            </label>
            <span asp-validation-for="CurrentCountdownMinutes" class="text-xs text-red-600"></span>

            <button class="rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5" type="submit">
                Save
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
