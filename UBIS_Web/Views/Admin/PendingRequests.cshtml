@model PendingRequestsViewModel
@{
    ViewData["Title"] = "Pending Change Requests";
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between">
            <h1 class="text-xl font-black text-navy dark:text-white">Pending Mobile / IP Change Requests</h1>
            <a asp-controller="Admin" asp-action="SessionSettings" class="text-xs font-bold text-navy underline">Session Settings</a>
        </div>
        <p class="mt-1 text-xs text-slate-500">Added 2026-07. Approving a request notifies the user and starts the 60-second forced-logout warning on their next poll.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
                @Model.StatusMessage
            </div>
        }

        <div class="mt-5 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-200 text-xs font-bold uppercase text-slate-500">
                        <th class="py-2 pr-4">User</th>
                        <th class="py-2 pr-4">Requested Mobile</th>
                        <th class="py-2 pr-4">Requested IP 1</th>
                        <th class="py-2 pr-4">Requested IP 2</th>
                        <th class="py-2 pr-4">Requested</th>
                        <th class="py-2 pr-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="py-6 text-center text-slate-400">No pending requests.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-b border-slate-100 dark:border-slate-800">
                            <td class="py-2 pr-4">
                                <div class="font-semibold">@item.UserName</div>
                                @if (!string.IsNullOrEmpty(item.FullName))
                                {
                                    <div class="text-xs text-slate-500">@item.FullName</div>
                                }
                            </td>
                            <td class="py-2 pr-4">@(item.RequestedMobile ?? "—")</td>
                            <td class="py-2 pr-4">@(item.RequestedIPAddressOne ?? "—")</td>
                            <td class="py-2 pr-4">@(item.RequestedIPAddressTwo ?? "—")</td>
                            <td class="py-2 pr-4">@item.RequestDate.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td class="py-2 pr-4">
                                <div class="flex gap-2">
                                    <form asp-controller="Admin" asp-action="Approve" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowId" value="@item.RowId" />
                                        <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-700">Approve</button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="Reject" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowId" value="@item.RowId" />
                                        <button type="submit" class="rounded-lg bg-red-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-red-700">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
