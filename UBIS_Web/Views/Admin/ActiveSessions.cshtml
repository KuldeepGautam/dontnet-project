@model ActiveSessionsViewModel
@{
    ViewData["Title"] = "Active Session Monitor";
}

<div class="mx-auto max-w-6xl space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between">
            <h1 class="text-xl font-black text-navy dark:text-white">Active Session Monitor</h1>
            <a asp-controller="Admin" asp-action="ActiveSessions" class="text-xs font-bold text-navy underline">Refresh</a>
        </div>
        <p class="mt-1 text-xs text-slate-500">Live sessions currently held in Redis. Last Activity refreshes automatically while a user has an authenticated page open; a session with no activity ages out after 5 minutes.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
                @Model.StatusMessage
            </div>
        }

        <div class="mt-5 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-200 text-xs font-bold uppercase text-slate-500">
                        <th class="py-2 pr-4">User</th>
                        <th class="py-2 pr-4">Role</th>
                        <th class="py-2 pr-4">IP Address</th>
                        <th class="py-2 pr-4">Login Time</th>
                        <th class="py-2 pr-4">Last Activity</th>
                        <th class="py-2 pr-4">Status</th>
                        <th class="py-2 pr-4">Expires In</th>
                        <th class="py-2 pr-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Sessions.Count == 0)
                    {
                        <tr><td colspan="8" class="py-6 text-center text-slate-400">No active sessions.</td></tr>
                    }
                    @foreach (var s in Model.Sessions)
                    {
                        <tr class="border-b border-slate-100 dark:border-slate-800">
                            <td class="py-2 pr-4">
                                <div class="font-semibold">@s.UserName</div>
                                <div class="text-xs text-slate-400">#@s.UserId</div>
                            </td>
                            <td class="py-2 pr-4">@s.RoleName</td>
                            <td class="py-2 pr-4">@(s.IPAddress ?? "—")</td>
                            <td class="py-2 pr-4">@s.LoginTimeUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm:ss")</td>
                            <td class="py-2 pr-4">@s.LastActivityUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm:ss")</td>
                            <td class="py-2 pr-4">
                                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-700">@s.Status</span>
                            </td>
                            <td class="py-2 pr-4">@(s.TimeToLiveSeconds.HasValue ? $"{Math.Max(0, (int)s.TimeToLiveSeconds.Value)}s" : "—")</td>
                            <td class="py-2 pr-4">
                                <form asp-controller="Admin" asp-action="ForceLogout" method="post" onsubmit="return confirm('Force logout user #@s.UserId (@s.UserName)? Every active session for this user will be revoked.');">
                                    <input type="hidden" name="userId" value="@s.UserId" />
                                    <button type="submit" class="rounded-lg border border-red-200 bg-red-50 px-2 py-1 text-xs font-bold text-red-700 hover:bg-red-100">Force Logout</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
