@model UserProfileViewModel
@using UBIS.Web.Services.Clients
@{
    ViewData["Title"] = "Profile Dashboard";
}

<div class="space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h1 class="text-xl font-black text-navy dark:text-white">Profile Dashboard</h1>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.StatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
                @Model.StatusMessage
            </div>
        }

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Username</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">@Model.UserName</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Role</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">@Model.RoleName</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Last Login</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">
                    @(Model.LastLoginDate?.ToString("dd MMM yyyy, HH:mm") ?? "—")
                </p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Department</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">@(Model.DepartmentId?.ToString() ?? "—")</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">User Creation Date</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">@(Model.UserCreationDate?.ToString("dd-MMM-yyyy") ?? "—")</p>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Created By</p>
                <p class="mt-1 text-sm font-bold text-navy dark:text-white">@(Model.CreatedBy?.ToString() ?? "—")</p>
            </div>
        </div>
        @if (!Model.HasLegacyRecord)
        {
            <p class="mt-3 text-xs text-slate-400">Department/Creation Date are unavailable — this account has no linked legacy record.</p>
        }

        @if (Model.AssignedStatements.Count > 0)
        {
            <div class="mt-4 border-t border-slate-100 pt-4 dark:border-slate-800">
                <h3 class="text-sm font-bold text-slate-500">My Assigned Statements / Profiles</h3>
                <ul class="mt-2 space-y-1 text-sm">
                    @foreach (var stmt in Model.AssignedStatements)
                    {
                        <li>
                            <span class="font-semibold">@stmt.StmtNo</span> — @stmt.StmtName
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-black text-navy dark:text-white">Network (IP) Profile</h2>
        <p class="mt-2 text-sm text-slate-500">
            Update your allowed IP addresses and raise a change request — an administrator must
            approve it before it takes effect.
        </p>

        @if (Model.LatestRequestStatus.HasValue)
        {
            var (badgeClass, badgeText) = Model.LatestRequestStatus switch
            {
                IpRequestStatus.Approved => ("border-emerald-200 bg-emerald-50 text-emerald-700", "Approved"),
                IpRequestStatus.NotApproved => ("border-red-200 bg-red-50 text-red-700", "Not Approved"),
                _ => ("border-amber-200 bg-amber-50 text-amber-700", "Pending Approval")
            };
            <div class="mt-4 rounded-xl border p-4 text-sm font-semibold @badgeClass">
                Latest request: @badgeText
                @if (Model.LatestRequestDate.HasValue)
                {
                    <span class="font-normal">— raised @Model.LatestRequestDate.Value.ToString("dd MMM yyyy, HH:mm")</span>
                }
                @if (Model.LatestRequestStatus != IpRequestStatus.Pending && Model.LatestApproveDate.HasValue)
                {
                    <span class="font-normal">, decided @Model.LatestApproveDate.Value.ToString("dd MMM yyyy, HH:mm")</span>
                }
            </div>
        }

        <form asp-controller="UserProfile" asp-action="RaiseIpChangeRequest" method="post" class="mt-5 space-y-4" novalidate>
            @Html.AntiForgeryToken()

            <label class="float-field">
                <input asp-for="IPAddress1" type="text" placeholder=" " autocomplete="off" inputmode="decimal" maxlength="15" data-mask="ip" data-mask-maxlength="15" />
                <span>IP Address 1</span>
            </label>
            <span asp-validation-for="IPAddress1" class="text-xs text-red-600"></span>

            <label class="float-field">
                <input asp-for="IPAddress2" type="text" placeholder=" " autocomplete="off" inputmode="decimal" maxlength="15" data-mask="ip" data-mask-maxlength="15" />
                <span>IP Address 2</span>
            </label>
            <span asp-validation-for="IPAddress2" class="text-xs text-red-600"></span>

            <button class="rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5" type="submit">
                Raise IP Change Request
            </button>
        </form>

        <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
            <h3 class="text-sm font-bold text-slate-500">My IP Change Requests</h3>
            @if (Model.IpRequestHistory.Count == 0)
            {
                <p class="mt-2 text-sm text-slate-400">You have not raised any IP change requests yet.</p>
            }
            else
            {
                <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-slate-200 text-xs font-bold uppercase tracking-wide text-slate-500 dark:border-slate-700">
                                <th class="py-2 pr-4">Request No.</th>
                                <th class="py-2 pr-4">IP Address 1</th>
                                <th class="py-2 pr-4">IP Address 2</th>
                                <th class="py-2 pr-4">Date Raised</th>
                                <th class="py-2 pr-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.IpRequestHistory)
                            {
                                var statusBadgeClass = req.Status == "Completed"
                                    ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                                    : "border-amber-200 bg-amber-50 text-amber-700";
                                <tr class="border-b border-slate-100 dark:border-slate-800">
                                    <td class="py-2 pr-4 font-semibold">@req.RequestNumber</td>
                                    <td class="py-2 pr-4">@(req.IPAddress1 ?? "—")</td>
                                    <td class="py-2 pr-4">@(req.IPAddress2 ?? "—")</td>
                                    <td class="py-2 pr-4">@(req.RequestDate?.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                                    <td class="py-2 pr-4">
                                        <span class="rounded-full border px-2 py-0.5 text-xs font-semibold @statusBadgeClass">@req.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-black text-navy dark:text-white">Contact Details</h2>
        <p class="mt-2 text-sm text-slate-500">
            Update your email address and mobile number — these save immediately, no approval needed.
        </p>

        <form asp-controller="UserProfile" asp-action="UpdateContact" method="post" class="mt-5 space-y-4" novalidate>
            @Html.AntiForgeryToken()

            <label class="float-field">
                <input asp-for="Email" type="email" placeholder=" " autocomplete="email" />
                <span>Email Address</span>
            </label>
            <span asp-validation-for="Email" class="text-xs text-red-600"></span>

            <p class="text-xs text-slate-500">
                Current mobile on file: <span class="font-semibold">@(Model.MaskedMobile ?? "—")</span>
            </p>
            <label class="float-field">
                <input asp-for="Mobile" type="text" placeholder=" " autocomplete="tel" inputmode="numeric" maxlength="10" data-mask="digits" data-mask-maxlength="10" />
                <span>New Mobile Number (leave blank to keep current)</span>
            </label>
            <span asp-validation-for="Mobile" class="text-xs text-red-600"></span>

            <button class="rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5" type="submit">
                Save Contact Details
            </button>
        </form>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-black text-navy dark:text-white">Change Password</h2>

        @if (!string.IsNullOrEmpty(Model.PasswordStatusMessage))
        {
            <div class="mt-3 rounded-xl p-4 text-sm font-semibold @(Model.PasswordStatusIsError ? "border border-red-200 bg-red-50 text-red-700" : "border border-emerald-200 bg-emerald-50 text-emerald-700")">
                @Model.PasswordStatusMessage
            </div>
        }

        <form asp-controller="UserProfile" asp-action="ChangePassword" method="post" class="mt-5 space-y-4">
            @Html.AntiForgeryToken()

            <label class="float-field">
                <input asp-for="CurrentPassword" type="password" placeholder=" " autocomplete="current-password" />
                <span>Current Password</span>
            </label>
            <span asp-validation-for="CurrentPassword" class="text-xs text-red-600"></span>

            <label class="float-field">
                <input asp-for="NewPassword" type="password" placeholder=" " autocomplete="new-password" />
                <span>New Password</span>
            </label>
            <span asp-validation-for="NewPassword" class="text-xs text-red-600"></span>

            <label class="float-field">
                <input asp-for="ConfirmNewPassword" type="password" placeholder=" " autocomplete="new-password" />
                <span>Confirm New Password</span>
            </label>
            <span asp-validation-for="ConfirmNewPassword" class="text-xs text-red-600"></span>

            <button class="rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5" type="submit">
                Update Password
            </button>
        </form>
    </div>

    <a asp-controller="User" asp-action="Dashboard" class="inline-block rounded-lg border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition hover:-translate-y-0.5 dark:border-slate-700 dark:text-slate-300">
        Close
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
