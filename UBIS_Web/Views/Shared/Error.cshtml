@model ErrorViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Error";
}

<div class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-soft dark:border-slate-800 dark:bg-slate-900">
    <h1 class="text-2xl font-black text-navy dark:text-white">Something went wrong</h1>
    <p class="mt-2 text-sm text-slate-500">Please try again, or contact your system administrator if the problem persists.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-slate-400">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-area="" asp-controller="User" asp-action="Login" class="mt-6 inline-block rounded-lg bg-navy px-5 py-3 text-sm font-black text-white shadow-lg">Return to Login</a>
</div>
