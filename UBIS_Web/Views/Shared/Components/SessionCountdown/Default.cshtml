@model int
<span class="hidden items-center gap-1 rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-600 sm:flex dark:bg-slate-900 dark:text-slate-300"
      title="Session time remaining">
    <i data-lucide="clock" class="h-3.5 w-3.5"></i>
    <span id="session-countdown" data-countdown-seconds="@(Model * 60)">--:--</span>
</span>
