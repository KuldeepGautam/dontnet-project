<!doctype html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - UBIS Enterprise</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">
    <script src="~/vendor/lucide.min.js" defer></script>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
</head>
<body class="min-h-full bg-[#f7fbff] text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <header class="bg-white/95 shadow-sm finance-hero">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 sm:px-6 lg:px-8">
            <div class="flex items-center gap-4">
                <div class="emblem"><img src="~/images/emblem-dark.png" alt="Government of India" width="55" height="55"></div>
                <div class="leading-tight">
                    <p class="font-extrabold">भारत सरकार</p>
                    <p class="text-sm font-bold text-navy">Government of India</p>
                    <p class="font-extrabold">वित्त मंत्रालय</p>
                    <p class="text-sm font-bold text-navy">MINISTRY OF FINANCE</p>
                </div>
            </div>
            <div class="hidden text-right md:block">
                <div class="flex justify-end"><img src="~/images/ubis_Logo.png" alt="UBIS Logo" class="w-[120px] h-auto"></div>
                <h1 class="text-xl font-extrabold tracking-wide text-slate-900">UNION BUDGET INFORMATION SYSTEM</h1>
                <p class="mt-1 text-xs font-black uppercase text-slate-700">Department of Economic Affairs, Ministry of Finance</p>
            </div>
        </div>
    </header>

    <main class="min-h-[680px] px-4 py-10 bg-gradient">
        @RenderBody()
    </main>

    <footer class="bg-slate-950 px-6 py-8 text-sm font-semibold text-white">
        <div class="mx-auto max-w-7xl">Union Budget Information System</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
