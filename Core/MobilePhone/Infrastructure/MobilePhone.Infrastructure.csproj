<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UBIS.Services.MobilePhone.Infrastructure</RootNamespace>
    <AssemblyName>MobilePhone.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure layer depends on Application and Domain -->
    <ProjectReference Include="..\Application\MobilePhone.Application.csproj" />
    <ProjectReference Include="..\Domain\MobilePhone.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core packages for SmsDispatchLog persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Messaging: notification consumer + LogWriter publisher -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />

    <!-- Options binding and logging -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />

    <!-- Direct override: forces NuGet to resolve the patched version instead of the vulnerable
         9.0.0 pulled in transitively (by Microsoft.EntityFrameworkCore.Design). Matches
         Email.Infrastructure.csproj's own pin - re-check for a newer patch release if this
         warning reappears; a version pin like this doesn't self-update. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
