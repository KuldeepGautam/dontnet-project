    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UBIS.Services.Reporting.WebApi</RootNamespace>
    <AssemblyName>Reporting.WebApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Reporting.Infrastructure.csproj" />
    <ProjectReference Include="..\Application\Reporting.Application.csproj" />
