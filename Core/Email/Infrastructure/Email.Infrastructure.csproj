<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UBIS.Services.Email.Infrastructure</RootNamespace>
    <AssemblyName>Email.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure layer depends on Application and Domain -->
    <ProjectReference Include="..\Application\Email.Application.csproj" />
    <ProjectReference Include="..\Domain\Email.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core packages for EmailDispatchLog persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Messaging: OTP consumer + LogWriter publisher -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />

    <!-- SMTP: replaces System.Net.Mail.SmtpClient, which only supports STARTTLS (explicit TLS) and
         not implicit SSL - GoDaddy's smtpout.secureserver.net on port 465 requires implicit SSL. -->
    <PackageReference Include="MailKit" Version="4.17.0" />

    <!-- Options binding and logging -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />

    <!-- Direct override: forces NuGet to resolve the patched version instead of the vulnerable
         9.0.0 pulled in transitively (by Microsoft.EntityFrameworkCore.Design).
         Bumped 10.0.9 -> 10.0.10 (2026-08-03): 10.0.9 itself picked up 5 new high-severity CVEs
         (NU1903) after this override was first added - re-check for a newer patch release if this
         warning reappears; a version pin like this doesn't self-update. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
