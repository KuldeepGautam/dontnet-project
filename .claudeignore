# Reduces tokens spent on Glob/Grep/Read results by excluding paths that are never source-of-truth:
# build output (regenerates every build, already caused several stale-vs-source mixups this session),
# vendored/minified third-party JS (never hand-edited), and generated/publish artifacts.

# .NET build output - every project's obj/bin, at any depth
**/bin/
**/obj/

# dotnet publish output staged for IIS deploy (regenerated by Republish-Microservices.ps1)
Others/publish-staging/**/publish/
**/PubTmp/

# Vendored/minified third-party JS and its source maps - never hand-edited, large, not source
**/wwwroot/lib/**
**/wwwroot/vendor/**
**/*.min.js
**/*.min.js.map
**/*.min.css

# Logs written at runtime, not source
**/logs/*.txt
**/logs/*.log

# IDE/editor noise
**/.vs/
**/.vscode/

# Data Protection keys (per-machine generated secrets, never source)
**/App_Data/DataProtection-Keys/**

# Playwright browser-tests tool (live smoke-testing helper, not app source)
Others/browser-tests/
